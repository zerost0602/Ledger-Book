function doGet() {
  return HtmlService.createHtmlOutputFromFile('index')
      .setTitle('DoubleBook - GAS 통합 가계부')
      .addMetaTag('viewport', 'width=device-width, initial-scale=1')
      .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

function getSheet(name, ssInstance) {
  const ss = ssInstance || SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName(name);
  if (!sheet) {
    sheet = ss.insertSheet(name);
    if (name === 'Transactions') {
      sheet.appendRow(['id', 'date', 'debits', 'credits', 'memo', 'vendor']);
    } else if (name === 'Settings') {
      sheet.appendRow(['key', 'value']);
    } else if (name === 'Budgets') {
      sheet.appendRow(['month', 'data']);
    }
  }
  return sheet;
}

function validateTransaction_(tx) {
  if (!tx || !tx.date || !String(tx.memo || '').trim()) {
    console.error("Invalid transaction: missing date or memo", tx);
    return false;
  }
  if (!Array.isArray(tx.debits) || !Array.isArray(tx.credits) || tx.debits.length === 0 || tx.credits.length === 0) {
    console.error("Invalid transaction: empty debits or credits", tx);
    return false;
  }
  const hasInvalidRow =
    tx.debits.some(function(d) { return !(d.accountId || d.account) || Number(d.amount || 0) <= 0; }) ||
    tx.credits.some(function(c) { return !(c.accountId || c.account) || Number(c.amount || 0) <= 0; });
  if (hasInvalidRow) {
    console.error("Invalid transaction: missing accountId or non-positive amount", tx);
    return false;
  }
  const debitSum = tx.debits.reduce(function(s, d) { return s + Number(d.amount || 0); }, 0);
  const creditSum = tx.credits.reduce(function(s, c) { return s + Number(c.amount || 0); }, 0);
  if (debitSum <= 0 || debitSum !== creditSum) {
    console.error("Invalid transaction: unbalanced debits and credits", debitSum, creditSum);
    return false;
  }
  return true;
}

function toTransactionRow_(tx) {
  return [
    String(tx.id),
    tx.date,
    JSON.stringify(tx.debits),
    JSON.stringify(tx.credits),
    String(tx.memo).trim(),
    tx.vendor || ''
  ];
}

function findTransactionRow_(sheet, id) {
  const lastRow = sheet.getLastRow();
  if (lastRow <= 1) return -1;
  const cell = sheet
    .getRange(2, 1, lastRow - 1, 1)
    .createTextFinder(String(id))
    .matchEntireCell(true)
    .matchCase(true)
    .findNext();
  return cell ? cell.getRow() : -1;
}

function getAllData() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const tz = Session.getScriptTimeZone();
  const settingsSheet = getSheet('Settings', ss);
  const transSheet = getSheet('Transactions', ss);
  
  const settingsLastRow = settingsSheet.getLastRow();
  const settingsRaw = settingsLastRow > 1 ? settingsSheet.getRange(2, 1, settingsLastRow - 1, 2).getValues() : [];
  const transLastRow = transSheet.getLastRow();
  const transRaw = transLastRow > 1 ? transSheet.getRange(2, 1, transLastRow - 1, 6).getValues() : [];
  
  let initialSetup = { debits: [{ account: '현금', amount: 0 }], credits: [] };
  let accounts = {
    assets: [{ id: 'a1', name: '현금', subtype: 'fixed' }],
    liabilities: [{ id: 'l1', name: '신용카드', subtype: 'variable' }, { id: 'e1', name: '이익잉여금', subtype: 'fixed' }],
    revenue: [{ id: 'r1', name: '급여', subtype: 'fixed' }],
    expenses: [{ id: 'x1', name: '식비', subtype: 'variable' }]
  };
  
  settingsRaw.forEach(row => {
    if (row[0] === 'initialSetup' && row[1]) initialSetup = JSON.parse(row[1]);
    if (row[0] === 'accounts' && row[1]) accounts = JSON.parse(row[1]);
  });
  
  const transactions = [];
  for (let i = 0; i < transRaw.length; i++) {
    try {
      const row = transRaw[i];
      if (!row[0]) continue;
      transactions.push({
        id: String(row[0]),
        date: row[1] instanceof Date ? Utilities.formatDate(row[1], tz, 'yyyy-MM-dd') : row[1],
        debits: JSON.parse(row[2]),
        credits: JSON.parse(row[3]),
        memo: row[4],
        vendor: row[5] || ''
      });
    } catch (e) { console.error("Data parse error", e); }
  }

  const budgets = ensureBudgets(ss, tz);

  return { initialSetup, accounts, transactions, budgets };
}

function saveTransaction(tx) {
  if (!validateTransaction_(tx)) return false;
  var lock = LockService.getScriptLock();
  var hasLock = false;
  try {
    lock.waitLock(10000);
    hasLock = true;
    const sheet = getSheet('Transactions');
    const rowIndex = findTransactionRow_(sheet, tx.id);
    const rowData = toTransactionRow_(tx);
    
    if (rowIndex > -1) {
      sheet.getRange(rowIndex, 1, 1, 6).setValues([rowData]);
    } else {
      sheet.appendRow(rowData);
    }
    return true;
  } catch (e) {
    console.error("saveTransaction error:", e);
    return false;
  } finally {
    if (hasLock) lock.releaseLock();
  }
}

function saveTransactionsBatch(txList) {
  if (!Array.isArray(txList) || txList.length === 0) return true;
  for (var k = 0; k < txList.length; k++) {
    if (!validateTransaction_(txList[k])) return false;
  }

  var lock = LockService.getScriptLock();
  var hasLock = false;
  try {
    lock.waitLock(15000);
    hasLock = true;
    const sheet = getSheet('Transactions');
    const lastRow = sheet.getLastRow();
    const idMap = {};

    if (lastRow > 1) {
      const idValues = sheet.getRange(2, 1, lastRow - 1, 1).getValues();
      for (let i = 0; i < idValues.length; i++) {
        const existingId = String(idValues[i][0]);
        if (existingId) idMap[existingId] = i + 2;
      }
    }

    const rowsToAppend = [];
    for (let j = 0; j < txList.length; j++) {
      const tx = txList[j];
      const rowData = toTransactionRow_(tx);
      const existingRow = idMap[String(tx.id)];
      if (existingRow) {
        sheet.getRange(existingRow, 1, 1, 6).setValues([rowData]);
      } else {
        rowsToAppend.push(rowData);
      }
    }

    if (rowsToAppend.length > 0) {
      const appendStartRow = sheet.getLastRow() + 1;
      sheet.getRange(appendStartRow, 1, rowsToAppend.length, 6).setValues(rowsToAppend);
    }
    return true;
  } catch (e) {
    console.error("saveTransactionsBatch error:", e);
    return false;
  } finally {
    if (hasLock) lock.releaseLock();
  }
}

function deleteTransaction(id) {
  var lock = LockService.getScriptLock();
  var hasLock = false;
  try {
    lock.waitLock(10000);
    hasLock = true;
    const sheet = getSheet('Transactions');
    const rowIndex = findTransactionRow_(sheet, id);
    if (rowIndex > -1) {
      sheet.deleteRow(rowIndex);
      return true;
    }
    return false;
  } catch (e) {
    console.error("deleteTransaction error:", e);
    return false;
  } finally {
    if (hasLock) lock.releaseLock();
  }
}

function saveSettings(settingsData) {
  var lock = LockService.getScriptLock();
  var hasLock = false;
  try {
    lock.waitLock(10000);
    hasLock = true;
    const sheet = getSheet('Settings');
    sheet.clearContents();
    const data = [
      ['key', 'value'],
      ['initialSetup', JSON.stringify(settingsData.initialSetup)],
      ['accounts', JSON.stringify(settingsData.accounts)]
    ];
    sheet.getRange(1, 1, data.length, data[0].length).setValues(data);
    return true;
  } catch (e) {
    return false;
  } finally {
    if (hasLock) lock.releaseLock();
  }
}

function saveBudget(month, budgetData) {
  var lock = LockService.getScriptLock();
  var hasLock = false;
  try {
    lock.waitLock(10000);
    hasLock = true;
    const sheet = getSheet('Budgets');
    const tz = Session.getScriptTimeZone();
    const lastRow = sheet.getLastRow();
    const targetMonthStr = String(month).trim();
    const matchingRows = [];
    
    if (lastRow > 1) {
      const monthValues = sheet.getRange(2, 1, lastRow - 1, 1).getValues();
      for (let i = 0; i < monthValues.length; i++) {
        let mVal = monthValues[i][0];
        let mStr = mVal instanceof Date
          ? Utilities.formatDate(mVal, tz, 'yyyy-MM')
          : String(mVal).trim();
        if (mStr === targetMonthStr) {
          matchingRows.push(i + 2);
        }
      }
    }
    
    const rowData = [targetMonthStr, JSON.stringify(budgetData)];
    
    if (matchingRows.length > 0) {
      const firstRow = matchingRows[0];
      sheet.getRange(firstRow, 1, 1, 2).setValues([rowData]);
      for (let j = matchingRows.length - 1; j > 0; j--) {
        sheet.deleteRow(matchingRows[j]);
      }
    } else {
      sheet.appendRow(rowData);
    }
    return true;
  } catch (e) {
    console.error("saveBudget error:", e);
    return false;
  } finally {
    if (hasLock) lock.releaseLock();
  }
}

function ensureBudgets(ssInstance, tzInstance) {
  const sheet = getSheet('Budgets', ssInstance);
  const tz = tzInstance || Session.getScriptTimeZone();
  const lastRow = sheet.getLastRow();
  const budgets = {};
  
  if (lastRow > 1) {
    const rawData = sheet.getRange(2, 1, lastRow - 1, 2).getValues();
    for (let i = 0; i < rawData.length; i++) {
      try {
        let mKey = rawData[i][0];
        if (mKey instanceof Date) {
          mKey = Utilities.formatDate(mKey, tz, 'yyyy-MM');
        } else {
          mKey = String(mKey).trim();
        }
        if (mKey && rawData[i][1]) {
          budgets[mKey] = JSON.parse(rawData[i][1]);
        }
      } catch (e) {
        console.error("Budget parse error", e);
      }
    }
  }
  
  return budgets;
}

