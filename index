const formatMoney = (amount, options = {}) => {
  const num = Number(amount || 0);
  if (num < 0) {
    return `(${Math.abs(num).toLocaleString()})원`;
  }
  return `${num.toLocaleString()}원`;
};

const MoneyText = ({ amount, className = '', colorClass = '' }) => {
  const num = Number(amount || 0);
  const isNeg = num < 0;
  const defaultColor = isNeg ? 'text-rose-600' : 'text-slate-800';
  const finalColor = colorClass || defaultColor;
  return html`
    <span className="font-mono font-black ${finalColor} ${className}">
      ${isNeg ? `(${Math.abs(num).toLocaleString()})` : num.toLocaleString()}원
