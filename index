              </div>

              <!-- 월별 상환 스케줄 표 -->
              <div className="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
                <div className="p-4 sm:p-5 border-b bg-slate-50 flex justify-between items-center">
                  <h4 className="font-black text-sm text-slate-800 flex items-center gap-2">
                    <${Icon} name="list-ordered" className="w-4 h-4 text-indigo-600" />
                    <span>회차별 상환 스케줄 타임라인</span>
                  </h4>
                  <span className="text-xs text-slate-400 font-bold">
                    총 ${repaymentSchedule.schedule.length}회차 분할 납부
                  </span>
                </div>

                <div className="overflow-x-auto max-h-[420px] modal-scroll">
                  <table className="w-full text-left border-collapse text-xs">
                    <thead className="bg-slate-50 text-slate-400 text-[10px] font-black uppercase tracking-wider sticky top-0 border-b">
                      <tr>
                        <th className="py-2.5 px-4 text-center w-12">회차</th>
                        <th className="py-2.5 px-4">대상월</th>
