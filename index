    ];
  }, [accounts]);

  const [selectedAccId, setSelectedAccId] = useState(() => {
    const lAcc = accounts.liabilities.find(a => a.name.includes('할부') || a.name.includes('카드') || a.name !== '이익잉여금');
    return lAcc ? lAcc.id : (accounts.assets[0]?.id || '');
  });

  const selectedAccount = useMemo(() => {
    return allAccountsForSim.find(a => String(a.id) === String(selectedAccId)) || allAccountsForSim[0];
  }, [allAccountsForSim, selectedAccId]);

  const currentAccBalance = useMemo(() => {
    if (!selectedAccount) return 0;
    const raw = accountBalances[selectedAccount.id] || 0;
    return selectedAccount.category === 'liabilities' ? -raw : raw;
  }, [selectedAccount, accountBalances]);

  const [calcMode, setCalcMode] = useState('byAmount'); // 'byAmount' | 'byMonths'
  const [inputMonthlyAmount, setInputMonthlyAmount] = useState(200000);
  const [inputTargetMonths, setInputTargetMonths] = useState(12);
  const [annualInterestRate, setAnnualInterestRate] = useState(0);
  const [startMonth, setStartMonth] = useState(() => formatLocalYearMonth());

  const repaymentSchedule = useMemo(() => {
    const principal = Math.abs(currentAccBalance);
    if (principal <= 0) return { schedule: [], totalMonths: 0, totalPaid: 0, totalInterest: 0, monthlyPay: 0, endYearMonth: startMonth };

    const monthlyRate = (annualInterestRate / 100) / 12;
    let monthlyPay = 0;
    let months = 0;

    if (calcMode === 'byAmount') {
      monthlyPay = Math.max(1000, Number(inputMonthlyAmount || 0));
    } else {
      months = Math.max(1, Number(inputTargetMonths || 1));
      if (monthlyRate > 0) {
        monthlyPay = Math.round(principal * (monthlyRate * Math.pow(1 + monthlyRate, months)) / (Math.pow(1 + monthlyRate, months) - 1));
      } else {
        monthlyPay = Math.ceil(principal / months);
      }
    }

    const schedule = [];
    let remPrincipal = principal;
    const [sYear, sMonth] = startMonth.split('-').map(Number);
    let curDate = new Date(sYear, sMonth - 1, 1);
    let totalInterest = 0;
    let totalPaid = 0;
    let maxIter = 360;

    while (remPrincipal > 0 && maxIter > 0) {
      maxIter--;
      const ym = `${curDate.getFullYear()}-${String(curDate.getMonth() + 1).padStart(2, '0')}`;
      const interest = monthlyRate > 0 ? Math.round(remPrincipal * monthlyRate) : 0;
      let pay = monthlyPay;
      if (remPrincipal + interest < pay) {
        pay = remPrincipal + interest;
      }
      const payPrincipal = pay - interest;
      remPrincipal = Math.max(0, remPrincipal - payPrincipal);
      totalInterest += interest;
      totalPaid += pay;

      schedule.push({
        round: schedule.length + 1,
        yearMonth: ym,
        pay,
        payPrincipal,
        interest,
        remPrincipal
      });

      curDate.setMonth(curDate.getMonth() + 1);
    }

    const endYearMonth = schedule.length > 0 ? schedule[schedule.length - 1].yearMonth : startMonth;

    return {
      schedule,
      totalMonths: schedule.length,
      totalPaid,
      totalInterest,
      monthlyPay,
      endYearMonth
    };
  }, [currentAccBalance, calcMode, inputMonthlyAmount, inputTargetMonths, annualInterestRate, startMonth]);

  // ---- 2. 종합 순자산 & 미래 재정 예측 상태 ----
  const currentNetWorth = totalAssets - totalLiabilitiesOnly;

  const recentAverages = useMemo(() => {
    const today = new Date();
    const threeMonthsAgo = formatLocalDate(new Date(today.getFullYear(), today.getMonth() - 3, 1));
    const recentTxs = transactions.filter(t => t.date >= threeMonthsAgo && !isClosingTransaction(t));

    let revSum = 0;
    let expSum = 0;

    recentTxs.forEach(t => {
      t.credits.forEach(c => {
        if (accounts.revenue.some(a => String(a.id) === String(c.accountId))) revSum += Number(c.amount || 0);
      });
      t.debits.forEach(d => {
        if (accounts.revenue.some(a => String(a.id) === String(d.accountId))) revSum -= Number(d.amount || 0);
        if (accounts.expenses.some(a => String(a.id) === String(d.accountId))) expSum += Number(d.amount || 0);
      });
      t.credits.forEach(c => {
        if (accounts.expenses.some(a => String(a.id) === String(c.accountId))) expSum -= Number(c.amount || 0);
      });
    });

    const monthsCount = Math.max(1, Math.min(3, new Set(recentTxs.map(t => t.date.slice(0, 7))).size || 1));
    const avgRev = Math.round(revSum / monthsCount);
    const avgExp = Math.round(expSum / monthsCount);

    return {
      avgRevenue: avgRev > 0 ? avgRev : 3000000,
      avgExpense: avgExp > 0 ? avgExp : 1800000
    };
  }, [transactions, accounts]);

  const [simMonthlyRevenue, setSimMonthlyRevenue] = useState(recentAverages.avgRevenue);
  const [simMonthlyExpense, setSimMonthlyExpense] = useState(recentAverages.avgExpense);
  const [simMonths, setSimMonths] = useState(12);
  const [simAssetReturnRate, setSimAssetReturnRate] = useState(0);

  const monthlySurplus = Number(simMonthlyRevenue || 0) - Number(simMonthlyExpense || 0);

  const netWorthProjection = useMemo(() => {
    const monthlyRate = (Number(simAssetReturnRate || 0) / 100) / 12;
    let curNet = currentNetWorth;
    const timeline = [];
    const today = new Date();
    let milestone50M = null;
    let milestone100M = null;
    let milestone300M = null;
    let milestone500M = null;

    for (let m = 1; m <= Number(simMonths || 12); m++) {
      const d = new Date(today.getFullYear(), today.getMonth() + m, 1);
      const ym = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
      const growth = monthlyRate > 0 && curNet > 0 ? Math.round(curNet * monthlyRate) : 0;
      curNet += monthlySurplus + growth;

      timeline.push({
        monthIndex: m,
        yearMonth: ym,
        netWorth: curNet,
        monthlySurplus,
        growth
      });

      if (!milestone50M && curNet >= 50000000) milestone50M = { month: ym, index: m };
      if (!milestone100M && curNet >= 100000000) milestone100M = { month: ym, index: m };
      if (!milestone300M && curNet >= 300000000) milestone300M = { month: ym, index: m };
      if (!milestone500M && curNet >= 500000000) milestone500M = { month: ym, index: m };
    }

    const finalNetWorth = timeline.length > 0 ? timeline[timeline.length - 1].netWorth : currentNetWorth;
    const diff = finalNetWorth - currentNetWorth;
    const pct = currentNetWorth > 0 ? ((diff / currentNetWorth) * 100).toFixed(1) : 0;

    return {
      timeline,
      finalNetWorth,
      diff,
      pct,
      milestones: { milestone50M, milestone100M, milestone300M, milestone500M }
    };
  }, [currentNetWorth, monthlySurplus, simMonths, simAssetReturnRate]);

  const compareScenarios = useMemo(() => {
    const m = Number(simMonths || 12);
    const baseFinal = currentNetWorth + (monthlySurplus * m);
    const cutExpSurplus = Number(simMonthlyRevenue || 0) - (Number(simMonthlyExpense || 0) * 0.85);
    const cutExpFinal = currentNetWorth + (cutExpSurplus * m);
    const boostRevSurplus = (Number(simMonthlyRevenue || 0) * 1.1) - Number(simMonthlyExpense || 0);
    const boostRevFinal = currentNetWorth + (boostRevSurplus * m);

    return {
      base: { label: '기본 계획 (현재 유지)', final: baseFinal, surplus: monthlySurplus },
      cutExp: { label: '지출 15% 절약 시', final: cutExpFinal, surplus: cutExpSurplus, diff: cutExpFinal - baseFinal },
      boostRev: { label: '수익 10% 증대 시', final: boostRevFinal, surplus: boostRevSurplus, diff: boostRevFinal - baseFinal }
    };
  }, [currentNetWorth, simMonthlyRevenue, simMonthlyExpense, simMonths, monthlySurplus]);

  return html`
    <div className="max-w-6xl mx-auto space-y-6 pb-16 text-slate-800">
      <!-- 시나리오 상단 탭 헤더 -->
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-4 sm:p-6 rounded-3xl border border-slate-200 shadow-sm">
        <div>
          <div className="flex items-center gap-2">
            <span className="p-2 bg-indigo-50 text-indigo-600 rounded-xl font-black">
              <${Icon} name="sparkles" className="w-5 h-5" />
            </span>
            <h2 className="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">미래 재정 시뮬레이션</h2>
          </div>
          <p className="text-xs sm:text-sm text-slate-500 font-medium mt-1">
            계정과목별 상환 스케줄 예측 및 미래 목표 순자산 도출을 위한 시뮬레이터입니다.
          </p>
        </div>

        <div className="flex p-1 bg-slate-100 rounded-2xl border border-slate-200 self-start sm:self-auto">
          <button
            onClick=${() => setActiveSubTab('repayment')}
            className=${`flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all ${activeSubTab === 'repayment' ? 'bg-white text-indigo-600 shadow-sm' : 'text-slate-500 hover:text-slate-800'}`}
          >
            <${Icon} name="credit-card" className="w-4 h-4" />
            <span>상환 / 적립 스케줄러</span>
          </button>
          <button
            onClick=${() => setActiveSubTab('networth')}
            className=${`flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all ${activeSubTab === 'networth' ? 'bg-white text-indigo-600 shadow-sm' : 'text-slate-500 hover:text-slate-800'}`}
          >
            <${Icon} name="trending-up" className="w-4 h-4" />
            <span>종합 순자산 예측</span>
          </button>
        </div>
      </div>

      <!-- 서브탭 1: 상환 / 적립 스케줄러 -->
      ${activeSubTab === 'repayment' && html`
        <div className="space-y-6">
          <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- 왼쪽: 시뮬레이션 설정 카드 -->
            <div className="lg:col-span-1 bg-white p-5 sm:p-6 rounded-3xl border border-slate-200 shadow-sm space-y-5 h-fit">
              <h3 className="text-base font-black text-slate-800 flex items-center gap-2 border-b pb-3">
                <${Icon} name="sliders" className="w-4 h-4 text-indigo-600" />
