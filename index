<script>
  window.onerror = function(message, source, lineno) {
    if (document.getElementById('boot-error-toast')) return false;
    var errDiv = document.createElement('div');
    errDiv.id = 'boot-error-toast';
    errDiv.style.cssText = 'position:fixed;bottom:16px;right:16px;max-width:420px;background:#fef2f2;color:#991b1b;border:1px solid #fecaca;padding:12px 16px;border-radius:12px;font-size:12px;z-index:99999;box-shadow:0 10px 25px rgba(0,0,0,0.12);display:flex;align-items:start;gap:10px;';
    var text = document.createElement('div');
    text.style.flex = '1';
    text.textContent = '오류 감지: ' + message + (lineno ? ' (Line ' + lineno + ')' : '');
    var closeBtn = document.createElement('button');
    closeBtn.textContent = '✕';
    closeBtn.style.cssText = 'font-weight:bold;padding:0 4px;cursor:pointer;color:#ef4444;';
    closeBtn.onclick = function() { errDiv.remove(); };
    errDiv.appendChild(text);
    errDiv.appendChild(closeBtn);
    if (document.body) document.body.appendChild(errDiv);
    return false;
  };
</script>
