            <div className="max-w-4xl mx-auto bg-white rounded-3xl border shadow-md p-5 sm:p-8 space-y-8 sm:space-y-12 text-slate-800">
              <section>
                <div className="flex justify-between items-end border-b-4 border-emerald-500 pb-2 mb-4 sm:mb-6 font-black"><h3 className="text-base sm:text-2xl text-emerald-600 uppercase">I. Revenue</h3><span className="font-mono text-lg sm:text-2xl font-black text-emerald-600">${revenueHierarchy.total.toLocaleString()}원</span></div>
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
                  ${revenueHierarchy.groups.filter(g => g.subtotal !== 0).map(group => html`
                    <div key=${group.label} className="bg-slate-50 rounded-2xl p-4 border text-slate-800 font-bold">
                      <div className="flex justify-between text-[10px] sm:text-xs font-black text-slate-400 uppercase mb-3 border-b pb-1"><span>${group.label}</span><span>${group.subtotal.toLocaleString()}원</span></div>
                      <div className="space-y-1">
                        ${group.accounts.map(a => {
                          const totalAmount = Math.abs(a.amount || 0);
                          const sortedTags = Object.keys(a.tags || {}).map(tag => ({ tag, amount: a.tags[tag] })).filter(t => t.amount !== 0);
                          const taggedSum = sortedTags.reduce((sum, t) => sum + Math.abs(Number(t.amount) || 0), 0);
                          const untaggedAmount = totalAmount - taggedSum;
                          return html`
                          <div key=${a.name} className="flex flex-col py-1">
                            <div className="flex justify-between text-[11px] sm:text-sm py-0.5 italic">
                              <span>${a.name}</span><span className="font-mono">${a.amount.toLocaleString()}원</span>
                            </div>
                            ${sortedTags.map(t => React.createElement('div', { key: t.tag, className: "flex justify-between items-center mt-0.5 pl-3" },
                              React.createElement('span', { className: "text-[10px] text-slate-500 font-medium italic" }, "ㄴ " + t.tag),
                              React.createElement('span', { className: "font-mono text-[10px] text-slate-500 italic" }, Math.abs(t.amount).toLocaleString() + "원")
                            ))}
                            ${sortedTags.length > 0 && untaggedAmount !== 0 && React.createElement('div', { key: 'untagged', className: "flex justify-between items-center mt-0.5 pl-3" },
                              React.createElement('span', { className: "text-[10px] text-slate-400 font-medium italic" }, "ㄴ 그 외"),
                              React.createElement('span', { className: "font-mono text-[10px] text-slate-400 italic" }, Math.abs(untaggedAmount).toLocaleString() + "원")
                            )}
                          </div>
                        `})}
                      </div>
                    </div>
                  `)}
                </div>
              </section>
              <section>
                <div className="flex justify-between items-end border-b-4 border-orange-500 pb-2 mb-4 sm:mb-6 font-black"><h3 className="text-base sm:text-2xl text-orange-600 uppercase">II. Expenses</h3><span className="font-mono text-lg sm:text-2xl font-black text-orange-600">${expensesHierarchy.total.toLocaleString()}원</span></div>
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
                  ${expensesHierarchy.groups.filter(g => g.subtotal !== 0).map(group => html`
                    <div key=${group.label} className="bg-slate-50 rounded-2xl p-4 border text-slate-800 font-bold">
                      <div className="flex justify-between text-[10px] sm:text-xs font-black text-slate-400 uppercase mb-3 border-b pb-1"><span>${group.label}</span><span>${group.subtotal.toLocaleString()}원</span></div>
                      <div className="space-y-1">
                        ${group.accounts.map(a => {
                          const totalAmount = Math.abs(a.amount || 0);
                          const sortedTags = Object.keys(a.tags || {}).map(tag => ({ tag, amount: a.tags[tag] })).filter(t => t.amount !== 0);
                          const taggedSum = sortedTags.reduce((sum, t) => sum + Math.abs(Number(t.amount) || 0), 0);
                          const untaggedAmount = totalAmount - taggedSum;
                          return html`
                          <div key=${a.name} className="flex flex-col py-1">
                            <div className="flex justify-between text-[11px] sm:text-sm py-0.5 italic">
                              <span>${a.name}</span><span className="font-mono">${a.amount.toLocaleString()}원</span>
                            </div>
                            ${sortedTags.map(t => React.createElement('div', { key: t.tag, className: "flex justify-between items-center mt-0.5 pl-3" },
                              React.createElement('span', { className: "text-[10px] text-slate-500 font-medium italic" }, "ㄴ " + t.tag),
                              React.createElement('span', { className: "font-mono text-[10px] text-slate-500 italic" }, Math.abs(t.amount).toLocaleString() + "원")
                            ))}
                            ${sortedTags.length > 0 && untaggedAmount !== 0 && React.createElement('div', { key: 'untagged', className: "flex justify-between items-center mt-0.5 pl-3" },
                              React.createElement('span', { className: "text-[10px] text-slate-400 font-medium italic" }, "ㄴ 그 외"),
                              React.createElement('span', { className: "font-mono text-[10px] text-slate-400 italic" }, Math.abs(untaggedAmount).toLocaleString() + "원")
                            )}
                          </div>
                        `})}
                      </div>
                    </div>
                  `)}
                </div>
              </section>
              <div className=${`p-5 sm:p-8 rounded-2xl sm:rounded-3xl flex justify-between items-center shadow-inner border-2 sm:border-4 ${reportNetIncome >= 0 ? 'bg-emerald-50 border-emerald-100' : 'bg-red-50 border-red-100'}`}><div className="shrink-0 font-black"><h4 className="font-black text-sm sm:text-xl uppercase tracking-tighter text-slate-700">Net Income</h4></div><span className=${`font-mono text-xl sm:text-5xl font-black ${reportNetIncome >= 0 ? 'text-emerald-600' : 'text-red-500'}`}>${reportNetIncome.toLocaleString()}원</span></div>
            </div>
          `}

          ${currentView === 'GL' && (() => {
            const todayStr = getLocalTodayStr();
            const now = new Date();
            const thisMonthStart = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-01`;
            const thisMonthLastDay = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();
            const thisMonthEnd = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(thisMonthLastDay).padStart(2, '0')}`;
            const lastM = new Date(now.getFullYear(), now.getMonth() - 1, 1);
            const lastMonthStart = `${lastM.getFullYear()}-${String(lastM.getMonth() + 1).padStart(2, '0')}-01`;
            const lastMonthLastDay = new Date(lastM.getFullYear(), lastM.getMonth() + 1, 0).getDate();
            const lastMonthEnd = `${lastM.getFullYear()}-${String(lastM.getMonth() + 1).padStart(2, '0')}-${String(lastMonthLastDay).padStart(2, '0')}`;
            const thisYearStart = `${now.getFullYear()}-01-01`;
            const thisYearEnd = `${now.getFullYear()}-12-31`;

            const isAllRange = !searchDateRange.start && !searchDateRange.end;
            const isTodayRange = searchDateRange.start === todayStr && searchDateRange.end === todayStr;
            const isThisMonthRange = searchDateRange.start === thisMonthStart && searchDateRange.end === thisMonthEnd;
            const isLastMonthRange = searchDateRange.start === lastMonthStart && searchDateRange.end === lastMonthEnd;
            const isThisYearRange = searchDateRange.start === thisYearStart && searchDateRange.end === thisYearEnd;

            return html`
            <div className="max-w-6xl mx-auto space-y-6 pb-10">
              <${Card} className="flex flex-col gap-3 !p-4">
                <div className="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3">
                  <!-- 기간 선택 및 퀵 버튼 -->
                  <div className="flex flex-wrap items-center gap-2">
                    <div className="flex items-center gap-2 bg-slate-50 p-2 rounded-xl border border-slate-100">
                      <${Icon} name="calendar" className="text-slate-400 w-4 h-4 shrink-0" />
                      <input type="date" className="bg-transparent outline-none font-bold text-slate-600 text-[11px] sm:text-sm cursor-pointer" value=${searchDateRange.start} onChange=${e => setSearchDateRange({...searchDateRange, start: e.target.value})} />
                      <span className="text-slate-300">~</span>
                      <input type="date" className="bg-transparent outline-none font-bold text-slate-600 text-[11px] sm:text-sm cursor-pointer" value=${searchDateRange.end} onChange=${e => setSearchDateRange({...searchDateRange, end: e.target.value})} />
                      ${(searchDateRange.start || searchDateRange.end) && html`<button onClick=${() => setSearchDateRange({start: '', end: ''})} className="ml-1 text-slate-400 hover:text-red-500"><${Icon} name="x-circle" className="w-4 h-4" /></button>`}
                    </div>

                    <div className="flex items-center gap-1 bg-slate-100 p-1 rounded-xl text-xs font-bold text-slate-600">
                      <button onClick=${() => setSearchDateRange({ start: '', end: '' })} className=${`px-2.5 py-1 rounded-lg transition-colors ${isAllRange ? 'bg-white text-indigo-600 shadow-sm' : 'hover:bg-slate-200'}`}>전체</button>
                      <button onClick=${() => setSearchDateRange({ start: todayStr, end: todayStr })} className=${`px-2.5 py-1 rounded-lg transition-colors ${isTodayRange ? 'bg-white text-indigo-600 shadow-sm' : 'hover:bg-slate-200'}`}>오늘</button>
                      <button onClick=${() => setSearchDateRange({ start: thisMonthStart, end: thisMonthEnd })} className=${`px-2.5 py-1 rounded-lg transition-colors ${isThisMonthRange ? 'bg-white text-indigo-600 shadow-sm' : 'hover:bg-slate-200'}`}>이번달</button>
                      <button onClick=${() => setSearchDateRange({ start: lastMonthStart, end: lastMonthEnd })} className=${`px-2.5 py-1 rounded-lg transition-colors ${isLastMonthRange ? 'bg-white text-indigo-600 shadow-sm' : 'hover:bg-slate-200'}`}>지난달</button>
                      <button onClick=${() => setSearchDateRange({ start: thisYearStart, end: thisYearEnd })} className=${`px-2.5 py-1 rounded-lg transition-colors ${isThisYearRange ? 'bg-white text-indigo-600 shadow-sm' : 'hover:bg-slate-200'}`}>올해</button>
                    </div>

                    <button
                      onClick=${() => {
                        setSelectedLedgerAccount(null);
                        setShowAnomaliesOnly(prev => !prev);
                      }}
                      className=${`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold border transition-all ${showAnomaliesOnly ? 'bg-rose-600 text-white border-rose-600 shadow-sm' : anomalousTransactions.length > 0 ? 'bg-rose-50 text-rose-600 border-rose-200 hover:bg-rose-100' : 'bg-slate-50 text-slate-500 border-slate-200 hover:bg-slate-100'}`}
                    >
                      <${Icon} name="shield-alert" className="w-3.5 h-3.5" />
                      <span>이상거래</span>
                      <span className=${`px-1.5 py-0.2 rounded-full text-[10px] font-black ${showAnomaliesOnly ? 'bg-white/20 text-white' : anomalousTransactions.length > 0 ? 'bg-rose-200 text-rose-800' : 'bg-slate-200 text-slate-600'}`}>
                        ${anomalousTransactions.length}
                      </span>
                    </button>
                  </div>

                  <!-- 보고서 인쇄 버튼 -->
                  <div className="flex items-center gap-2 self-end md:self-auto">
                    <button
                      onClick=${() => setIsPrintReportModalOpen(true)}
                      className="flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs sm:text-sm px-4 py-2.5 rounded-xl shadow-sm transition-all active:scale-95"
                    >
                      <${Icon} name="printer" className="w-4 h-4" />
                      <span>거래내역 보고서 출력</span>
                    </button>
                  </div>
                </div>

                <div className="flex items-center gap-2 w-full pt-1 border-t border-slate-100">
                  <${Icon} name="search" className="w-5 h-5 text-slate-400 shrink-0" />
                  <input className="flex-1 bg-transparent outline-none font-bold text-slate-700 text-sm sm:text-base" placeholder="거래처, 거래내용, 거래금액(예: 15000, 15,000원), 계정과목, 태그, 날짜로 실시간 검색..." value=${searchTerm} onChange=${e => setSearchTerm(e.target.value)} />
                  ${searchTerm && html`<button onClick=${() => setSearchTerm('')} className="text-slate-400 hover:text-slate-600"><${Icon} name="x-circle" className="w-4 h-4" /></button>`}
                </div>
              <//>

              ${selectedLedgerAccount && !showAnomaliesOnly ? html`
                <${AccountLedgerDetailView}
                  accountId=${selectedLedgerAccount.id}
                  category=${selectedLedgerAccount.category}
                  accounts=${accounts}
                  initialSetup=${initialSetup}
                  transactions=${transactions}
                  standardDate=${standardDate}
                  dateRange=${searchDateRange}
                  searchTerm=${searchTerm}
                  getAccountById=${getAccountById}
                  onBack=${() => setSelectedLedgerAccount(null)}
                  onEditTransaction=${openEditTransactionModal}
                  onPrint=${() => setIsPrintReportModalOpen(true)}
                />
              ` : (showAnomaliesOnly || searchTerm || searchDateRange.start || searchDateRange.end) ? html`
                <${Card}>
                  <div className="border-b px-5 py-4 bg-slate-50 flex justify-between items-center">
                    <h3 className="font-black uppercase tracking-widest text-sm text-slate-800">
                      ${showAnomaliesOnly ? `이상거래 점검 결과 (${filteredTxs.length}건)` : `검색 결과 (${filteredTxs.length}건)`}
                    </h3>
                    <button onClick=${() => setIsPrintReportModalOpen(true)} className="text-xs text-indigo-600 hover:text-indigo-800 font-bold flex items-center gap-1">
                      <${Icon} name="printer" className="w-3.5 h-3.5" />
                      <span>이 결과 인쇄하기</span>
                    </button>
                  </div>
                  <div className="p-5 space-y-3">
                    ${filteredTxs.length === 0 && html`
                      <p className="text-center text-slate-400 py-8 text-sm">
                        ${showAnomaliesOnly ? '포착된 이상거래가 없습니다. 모든 전표가 정상입니다.' : '검색 결과가 없습니다.'}
                      </p>
                    `}
                    ${filteredTxs.map(t => {
                      const anomalies = getTransactionAnomalies(t, getAccountById);
                      const hasAnomaly = anomalies.length > 0;
                      return html`
                        <div key=${t.id} onClick=${() => openEditTransactionModal(t)} className=${`p-4 border rounded-xl hover:shadow-md transition-shadow cursor-pointer ${hasAnomaly ? 'border-rose-200 bg-rose-50/40' : 'border-slate-100 bg-slate-50'}`}>
                          <div className="flex flex-wrap items-center justify-between gap-2 mb-1">
                            <div className="text-xs text-slate-400 font-black">${t.date || '날짜 미지정'}</div>
                            ${hasAnomaly && html`
                              <div className="flex flex-wrap gap-1">
                                ${anomalies.map(reason => html`
                                  <span key=${reason} className="bg-rose-100 text-rose-700 border border-rose-200 text-[10px] font-black px-2 py-0.5 rounded-full">
                                    ⚠ ${reason}
                                  </span>
                                `)}
                              </div>
                            `}
                          </div>
                          <div className="font-bold text-slate-700 mb-3 flex items-center gap-1.5">
                            ${t.vendor && html`<span className="bg-indigo-50 text-indigo-700 border border-indigo-100 text-[10px] px-2 py-0.5 rounded-md font-extrabold shrink-0">${t.vendor}</span>`}
                            <span className=${!t.memo || !String(t.memo).trim() ? 'text-rose-500 italic' : ''}>${t.memo && String(t.memo).trim() ? t.memo : '거래내용 누락'}</span>
                          </div>
                          <div className="grid grid-cols-2 gap-4 text-sm bg-white p-3 rounded-lg border border-slate-100">
                            <div>
                              <div className="text-[10px] text-slate-400 uppercase font-black mb-1 border-b pb-1">차변 (Debit)</div>
                              ${(t.debits || []).length === 0
                                ? html`<div className="text-xs text-rose-500 font-bold py-0.5">차변 항목 없음</div>`
                                : t.debits.map((d, i) => html`
                                  <div key=${i} className="flex justify-between items-center py-0.5">
                                    <span className="text-indigo-600 font-medium text-xs">
                                      ${getAccountById(d.accountId)?.name || d.accountId}
                                      ${d.tag && html`<span className="text-[10px] text-slate-400 ml-1">#${d.tag}</span>`}
                                    </span>
                                    <${MoneyText} amount=${d.amount} className="text-xs" />
                                  </div>
                                `)
                              }
                            </div>
                            <div>
                              <div className="text-[10px] text-slate-400 uppercase font-black mb-1 border-b pb-1">대변 (Credit)</div>
                              ${(t.credits || []).length === 0
                                ? html`<div className="text-xs text-rose-500 font-bold py-0.5">대변 항목 없음</div>`
                                : t.credits.map((c, i) => html`
                                  <div key=${i} className="flex justify-between items-center py-0.5">
                                    <span className="text-red-500 font-medium text-xs">
                                      ${getAccountById(c.accountId)?.name || c.accountId}
                                      ${c.tag && html`<span className="text-[10px] text-slate-400 ml-1">#${c.tag}</span>`}
                                    </span>
                                    <${MoneyText} amount=${c.amount} className="text-xs" />
                                  </div>
                                `)
                              }
                            </div>
                          </div>
                        </div>
                      `;
                    })}
                  </div>
                <//>
              ` : html`
                <div className="space-y-2">
                  <p className="text-[11px] text-slate-400 font-bold px-1">계정과목을 클릭하면 해당 계정의 기간별 거래내역과 누적잔액(Running Balance) 원장을 확인할 수 있습니다.</p>
                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-6 text-slate-800">
                    ${['assets', 'liabilities', 'revenue', 'expenses'].map(cat => html`
                      <div key=${cat} className="bg-white p-4 sm:p-6 rounded-2xl border shadow-sm h-fit">
                        <h3 className="text-[10px] sm:text-xs font-black uppercase text-slate-400 mb-3 text-center tracking-widest">${cat.toUpperCase()} Accounts</h3>
                        <div className="space-y-1.5">
                          ${(cat === 'liabilities' ? [...(accounts[cat] || []), {id: 'closing_temp', name: '결산(임시)'}] : [...(accounts[cat] || [])]).sort((a,b) => a.name.localeCompare(b.name, 'ko-KR')).map(a => {
                            let bal = accountBalances[a.id] || 0;
                            if (cat === 'liabilities' || cat === 'revenue') bal = -bal;
                            const isNeg = bal < 0;
                            return html`
                              <button
                                key=${a.id}
                                type="button"
                                onClick=${() => setSelectedLedgerAccount({ id: a.id, category: cat })}
                                className="w-full flex items-center justify-between p-3 bg-slate-50 hover:bg-indigo-50/70 rounded-xl border border-transparent hover:border-indigo-200 font-bold transition-all group text-left active:scale-[0.99]"
                              >
                                <span className="text-xs sm:text-base group-hover:text-indigo-700 transition-colors">${a.name}</span>
                                <span className="flex items-center gap-1.5">
                                  <span className=${`font-mono text-sm sm:text-base ${isNeg ? 'text-rose-600 font-black' : 'text-slate-800'}`}>
                                    ${isNeg ? `(${Math.abs(bal).toLocaleString()})원` : `${bal.toLocaleString()}원`}
                                  </span>
                                  <${Icon} name="chevron-right" className="w-4 h-4 text-slate-300 group-hover:text-indigo-500 transition-colors shrink-0" />
                                </span>
                              </button>
                            `;
                          })}
                        </div>
                      </div>
                    `)}
                  </div>
                </div>
              `}
            </div>
            `;
          })()}

          ${currentView === 'EXPENSE_REPORT' && html`
            <${MonthlyIncomeExpenseReport} accounts=${accounts} transactions=${transactions} getAccountById=${getAccountById} onEditTransaction=${(txId) => {
              const tx = transactions.find(t => t.id === txId);
              if (tx) openEditTransactionModal(tx);
            }} />
          `}

          ${currentView === 'BUDGET' && html`
            <${MonthlyBudgetReport} accounts=${accounts} transactions=${transactions} budgets=${data.budgets} saveBudget=${saveBudget} />
          `}

          ${currentView === 'SCENARIO' && html`
            <${ScenarioView} 
              accounts=${accounts} 
              transactions=${transactions} 
              accountBalances=${accountBalances} 
              flatAccounts=${flatAccounts} 
              getAccountById=${getAccountById} 
              totalAssets=${totalAssets} 
              totalLiabilitiesOnly=${totalLiabilitiesOnly} 
            />
          `}

        </div>
      </main>

      <${SettingsModal}
        isOpen=${isSettingsModalOpen}
        onClose=${() => setIsSettingsModalOpen(false)}
        initialSetup=${initialSetup}
        accounts=${accounts}
        transactions=${transactions}
        flatAccounts=${flatAccounts}
        orphanAccountBalances=${orphanAccountBalances}
        retainedEarningsId=${retainedEarningsId}
        getAccountById=${getAccountById}
        setData=${setData}
        isDirty=${isDirty}
        setIsDirty=${setIsDirty}
        saveSettingsData=${saveSettingsData}
        saveTransactionsBatch=${saveTransactionsBatch}
        setConfirmDialog=${setConfirmDialog}
        setStatusMessage=${setStatusMessage}
      />

      <${EntryModal}
        isOpen=${isEntryModalOpen}
        onClose=${() => { setIsEntryModalOpen(false); setEditingTransaction(null); }}
        editingTransaction=${editingTransaction}
        defaultDate=${standardDate}
        accounts=${accounts}
        getAccountById=${getAccountById}
        onSave=${saveTransaction}
        onDeleteRequest=${handleDeleteTransactionRequest}
      />

      <${PrintReportModal} 
        isOpen=${isPrintReportModalOpen} 
        onClose=${() => setIsPrintReportModalOpen(false)} 
        transactions=${transactions} 
        accounts=${accounts} 
        getAccountById=${getAccountById} 
        dateRange=${searchDateRange} 
        searchTerm=${searchTerm}
        selectedAccountId=${selectedLedgerAccount?.id || null}
      />
    </div>
  `;
};

const Root = () => html`
  <${ErrorBoundary}>
    <${App} />
  <//>
`;

const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(html`<${Root} />`);
</script>
</body>
</html>
