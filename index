// --- 검색 파싱 및 이상거래 탐지 유틸리티 ---
const parseSearchAmount = (token) => {
  if (!token) return null;
  const cleaned = token.trim().replace(/원(?:의|짜리|어치)?$/, '원');
  // 1) 숫자/콤마/원 패턴 (예: 15000, 15,000, 15000원, 15,000원)
  const plainMatch = cleaned.match(/^(\d[\d,]*)원?$/);
  if (plainMatch) {
    const num = Number(plainMatch[1].replace(/,/g, ''));
    return Number.isFinite(num) ? num : null;
  }
  // 2) 한글 금액 단위 패턴 (예: 5만원, 1.5만원, 1만5천원, 5천원)
  if (/[만천]/.test(cleaned)) {
    const korMatch = cleaned.match(/^(?:(\d+(?:\.\d+)?)만)?(?:(\d+(?:\.\d+)?)천)?(\d+)?원?$/);
    if (korMatch && (korMatch[1] || korMatch[2])) {
      const man = korMatch[1] ? Number(korMatch[1]) * 10000 : 0;
      const cheon = korMatch[2] ? Number(korMatch[2]) * 1000 : 0;
      const rest = korMatch[3] ? Number(korMatch[3]) : 0;
      const total = Math.round(man + cheon + rest);
      return Number.isFinite(total) ? total : null;
    }
  }
  return null;
};

const matchesTransactionSearch = (t, rawSearchTerm, getAccountById) => {
  if (!rawSearchTerm || !rawSearchTerm.trim()) return true;
  const normalizedQuery = rawSearchTerm.trim().toLowerCase().replace(/([\d,]+)\s+원/g, '$1원');
  const tokens = normalizedQuery.split(/\s+/).filter(Boolean);
  if (tokens.length === 0) return true;

  const memo = (t.memo || '').toLowerCase();
  const vendor = (t.vendor || '').toLowerCase();
  const dateStr = String(t.date || '').toLowerCase();
  const debits = t.debits || [];
  const credits = t.credits || [];

  const debitAmounts = debits.map(d => Number(d.amount || 0));
  const creditAmounts = credits.map(c => Number(c.amount || 0));
  const debitSum = debitAmounts.reduce((s, a) => s + a, 0);
  const creditSum = creditAmounts.reduce((s, a) => s + a, 0);

  const todayStr = getLocalTodayStr();
  const yesterdayStr = getLocalOffsetDateStr(-1);

  return tokens.every(token => {
    if (memo.includes(token)) return true;
    if (vendor.includes(token)) return true;
    if (dateStr.includes(token)) return true;
    if (token === '오늘' && dateStr === todayStr) return true;
    if (token === '어제' && dateStr === yesterdayStr) return true;

    const tagToken = token.startsWith('#') ? token.slice(1) : token;
    const dMatch = debits.some(d =>
      (getAccountById(d.accountId)?.name || '').toLowerCase().includes(token) ||
      (tagToken && d.tag && d.tag.toLowerCase().includes(tagToken))
    );
    if (dMatch) return true;

    const cMatch = credits.some(c =>
      (getAccountById(c.accountId)?.name || '').toLowerCase().includes(token) ||
      (tagToken && c.tag && c.tag.toLowerCase().includes(tagToken))
    );
    if (cMatch) return true;

    const parsedAmount = parseSearchAmount(token);
    if (parsedAmount !== null) {
      if (
        debitAmounts.some(a => a === parsedAmount) ||
        creditAmounts.some(a => a === parsedAmount) ||
        debitSum === parsedAmount ||
        creditSum === parsedAmount
      ) {
        return true;
      }
    }

    return false;
  });
};

const getTransactionAnomalies = (t, getAccountById) => {
  const reasons = [];
  const debits = t.debits || [];
  const credits = t.credits || [];

  if (!t.date || !String(t.date).trim()) {
    reasons.push('거래일자 누락');
  }
  if (debits.length === 0 || credits.length === 0) {
    reasons.push('차변/대변 항목 누락');
  }
  const hasMissingAccount =
    debits.some(d => !d.accountId || getAccountById(d.accountId)?.isUnknown) ||
    credits.some(c => !c.accountId || getAccountById(c.accountId)?.isUnknown);
  if (hasMissingAccount) {
    reasons.push('계정과목 미선택/미분류');
  }
  const hasInvalidAmount =
    debits.some(d => Number(d.amount || 0) <= 0) ||
    credits.some(c => Number(c.amount || 0) <= 0);
  if (hasInvalidAmount) {
    reasons.push('거래금액 오류(0원 이하)');
  }
  const dSum = debits.reduce((s, d) => s + Number(d.amount || 0), 0);
  const cSum = credits.reduce((s, c) => s + Number(c.amount || 0), 0);
  if (dSum !== cSum || dSum <= 0) {
    reasons.push('대차금액 불일치');
  }
  if (!t.memo || !String(t.memo).trim()) {
    reasons.push('거래내용 누락');
  }
  return reasons;
};

