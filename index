                <div className="mt-6 sm:mt-8 pt-4 border-t-2 border-slate-50 flex justify-between items-center font-black"><span className="text-xs sm:text-lg uppercase">Total Assets</span><span className="font-mono font-black text-lg sm:text-2xl text-indigo-600">${totalAssets.toLocaleString()}원</span></div>
              </div>
              <div className="bg-white p-5 sm:p-8 flex flex-col text-slate-800">
                <div className="flex-1">
