const MonthlyCalendar = ({ accounts, transactions, getAccountById, onEditTransaction }) => {
  const [currentDate, setCurrentDate] = useState(new Date());
  const [selectedDate, setSelectedDate] = useState(null);

  const year = currentDate.getFullYear();
  const month = currentDate.getMonth();
  const firstDayOfMonth = new Date(year, month, 1).getDay();
  const daysInMonth = new Date(year, month + 1, 0).getDate();

  const revenueAccountIds = useMemo(() => (accounts?.revenue || []).map(a => a.id), [accounts]);
  const expenseAccountIds = useMemo(() => (accounts?.expenses || []).map(a => a.id), [accounts]);

  const dailyData = useMemo(() => {
    const data = {};
    (transactions || []).forEach(tx => {
      if (isClosingTransaction(tx)) return;

      if (!data[tx.date]) data[tx.date] = { revenue: 0, expense: 0, txs: [] };
      data[tx.date].txs.push(tx);

      (tx.credits || []).forEach(c => { if (revenueAccountIds.includes(c.accountId)) data[tx.date].revenue += c.amount; });
      (tx.debits || []).forEach(d => {
        if (revenueAccountIds.includes(d.accountId)) data[tx.date].revenue -= d.amount;
        if (expenseAccountIds.includes(d.accountId)) data[tx.date].expense += d.amount;
      });
      (tx.credits || []).forEach(c => {
        if (expenseAccountIds.includes(c.accountId)) data[tx.date].expense -= c.amount;
      });
    });
    return data;
  }, [transactions, revenueAccountIds, expenseAccountIds]);

  const days = [];
  for (let i = 0; i < firstDayOfMonth; i++) days.push(null);
  for (let i = 1; i <= daysInMonth; i++) days.push(i);

  const handlePrevMonth = () => setCurrentDate(new Date(year, month - 1, 1));
  const handleNextMonth = () => setCurrentDate(new Date(year, month + 1, 1));

  return html`
    <div className="max-w-6xl mx-auto space-y-4 sm:space-y-6 animate-in fade-in duration-300 pb-10">
      <div className="bg-white p-4 sm:p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">
        <h2 className="text-lg sm:text-xl font-black text-slate-800 flex items-center gap-2">
          <${Icon} name="calendar-days" className="text-indigo-500" /> 월간 캘린더
        </h2>
        <div className="flex items-center gap-4">
          <button onClick=${handlePrevMonth} className="p-2 hover:bg-slate-100 rounded-full transition-colors text-slate-500"><${Icon} name="chevron-left" className="w-5 h-5" /></button>
          <span className="font-black text-slate-700 w-24 text-center">${year}년 ${month + 1}월</span>
          <button onClick=${handleNextMonth} className="p-2 hover:bg-slate-100 rounded-full transition-colors text-slate-500"><${Icon} name="chevron-right" className="w-5 h-5" /></button>
        </div>
      </div>

      <div className="bg-white p-3 sm:p-5 rounded-2xl shadow-sm border border-slate-200">
        <div className="grid grid-cols-7 gap-1 sm:gap-2 mb-2">
          ${['일', '월', '화', '수', '목', '금', '토'].map((d, i) => html`
            <div key=${d} className=${`text-center font-bold text-xs sm:text-sm py-2 ${i === 0 ? 'text-red-400' : i === 6 ? 'text-blue-400' : 'text-slate-400'}`}>${d}</div>
          `)}
        </div>
        <div className="grid grid-cols-7 gap-1 sm:gap-2">
          ${days.map((d, i) => {
            if (!d) return html`<div key=${i} className="bg-slate-50/50 rounded-xl min-h-[80px] sm:min-h-[120px]"></div>`;
            const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
            const info = dailyData[dateStr] || { revenue: 0, expense: 0, txs: [] };
            
            return html`
              <div key=${i} onClick=${() => info.txs.length > 0 && setSelectedDate(dateStr)} className=${`min-h-[75px] sm:min-h-[120px] p-0.5 sm:p-2 rounded-xl border transition-all flex flex-col min-w-0 ${info.txs.length > 0 ? 'cursor-pointer hover:border-indigo-400 hover:shadow-md bg-white border-slate-200' : 'bg-white border-slate-100'}`}>
                <span className=${`font-bold text-[10px] sm:text-sm mb-1 ml-1 ${i % 7 === 0 ? 'text-red-400' : i % 7 === 6 ? 'text-blue-400' : 'text-slate-600'}`}>${d}</span>
                <div className="flex-1 space-y-0.5 sm:space-y-1 mt-auto flex flex-col justify-end min-w-0 overflow-visible">
                  ${info.revenue !== 0 && html`
                    <div className="w-full text-right text-[10px] sm:text-xs font-mono font-black text-emerald-600 bg-emerald-50/60 sm:bg-emerald-50 px-0.5 rounded leading-[1.1] sm:leading-normal overflow-visible flex justify-end">
                      <div className="origin-right scale-[0.7] sm:scale-100 whitespace-nowrap">
                        ${info.revenue > 0 ? '+' : ''}${info.revenue.toLocaleString()}
                      </div>
                    </div>
                  `}
                  ${info.expense !== 0 && html`
                    <div className="w-full text-right text-[10px] sm:text-xs font-mono font-black text-red-500 bg-red-50/60 sm:bg-red-50 px-0.5 rounded leading-[1.1] sm:leading-normal overflow-visible flex justify-end">
                      <div className="origin-right scale-[0.7] sm:scale-100 whitespace-nowrap">
                        ${info.expense > 0 ? '-' : '+'}${Math.abs(info.expense).toLocaleString()}
                      </div>
                    </div>
                  `}
                </div>
              </div>
            `;
          })}
        </div>
      </div>

      <${Modal} isOpen=${!!selectedDate} onClose=${() => setSelectedDate(null)} title="${selectedDate} 상세 내역">
        <div className="space-y-3 modal-scroll max-h-[60vh] overflow-y-auto pr-2">
          ${selectedDate && dailyData[selectedDate] && dailyData[selectedDate].txs.map(tx => html`
            <div key=${tx.id} onClick=${() => { onEditTransaction(tx.id); setSelectedDate(null); }} className="p-3 border border-slate-100 bg-slate-50 rounded-xl hover:bg-indigo-50 hover:border-indigo-200 transition-all cursor-pointer shadow-sm">
              <div className="font-bold text-slate-700 mb-2 flex items-center gap-1.5">
                ${tx.vendor && html`<span className="bg-indigo-50 text-indigo-700 border border-indigo-100 text-[10px] px-2 py-0.5 rounded-md font-extrabold shrink-0">${tx.vendor}</span>`}
                <span>${tx.memo || '내역 없음'}</span>
              </div>
              <div className="grid grid-cols-2 gap-3 text-[11px] sm:text-xs bg-white p-2 rounded-lg border border-slate-100">
                <div>
                  <div className="text-[9px] text-slate-400 uppercase font-black mb-1">차변 (Debit)</div>
                  ${tx.debits.map((d, idx) => html`
                    <div key=${idx} className="flex justify-between items-center py-0.5">
                      <span className="text-indigo-600 font-medium truncate pr-1">${getAccountById(d.accountId)?.name}</span>
                      <${MoneyText} amount=${d.amount} className="text-[10px] sm:text-xs" />
                    </div>
                  `)}
                </div>
                <div>
                  <div className="text-[9px] text-slate-400 uppercase font-black mb-1">대변 (Credit)</div>
                  ${tx.credits.map((c, idx) => html`
                    <div key=${idx} className="flex justify-between items-center py-0.5">
                      <span className="text-red-500 font-medium truncate pr-1">${getAccountById(c.accountId)?.name}</span>
                      <${MoneyText} amount=${c.amount} className="text-[10px] sm:text-xs" />
                    </div>
                  `)}
                </div>
              </div>
            </div>
          `)}
        </div>
      <//>
    </div>
  `;
};

