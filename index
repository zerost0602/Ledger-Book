              <!-- 계정과목 선택 -->
              <div>
                <label className="text-[11px] font-black text-slate-400 uppercase tracking-wider block mb-1.5">대상 계정과목 선택</label>
                <select
                  value=${selectedAccId}
                  onChange=${(e) => setSelectedAccId(e.target.value)}
                  className="w-full p-3 rounded-xl bg-slate-50 border border-slate-200 text-sm font-bold text-slate-800 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                >
                  <optgroup label="부채 (상환 대상)">
                    ${accounts.liabilities.filter(a => a.name !== '이익잉여금').map(a => html`
                      <option key=${a.id} value=${a.id}>${a.name} (현재 잔액: ${(-(accountBalances[a.id] || 0)).toLocaleString()}원)</option>
                    `)}
                  </optgroup>
                  <optgroup label="자산 (적립 대상)">
                    ${accounts.assets.map(a => html`
                      <option key=${a.id} value=${a.id}>${a.name} (현재 잔액: ${(accountBalances[a.id] || 0).toLocaleString()}원)</option>
                    `)}
                  </optgroup>
                </select>
              </div>

              <!-- 현재 잔액 상태 카드 -->
              <div className="bg-slate-50 p-4 rounded-2xl border border-slate-200 space-y-1">
                <div className="flex justify-between items-center text-xs text-slate-500 font-bold">
                  <span>${selectedAccount?.name} 잔액</span>
                  <span className="text-[10px] font-black px-2 py-0.5 rounded-full ${selectedAccount?.category === 'liabilities' ? 'bg-red-50 text-red-600' : 'bg-emerald-50 text-emerald-600'}">
                    ${selectedAccount?.category === 'liabilities' ? '부채 계정' : '자산 계정'}
                  </span>
                </div>
                <div className="text-xl sm:text-2xl font-black font-mono ${currentAccBalance < 0 ? 'text-rose-600' : 'text-slate-900'}">
                  ${currentAccBalance < 0 ? `(${Math.abs(currentAccBalance).toLocaleString()})` : currentAccBalance.toLocaleString()}원
                </div>
                <p className="text-[10px] text-slate-400 font-medium">
                  ${selectedAccount?.category === 'liabilities' ? '* 완제 상환 목표 원금으로 자동 반영됩니다.' : '* 적립 시뮬레이션 기준 원금으로 사용됩니다.'}
                </p>
              </div>

              <!-- 계산 모드 토글 -->
              <div>
                <label className="text-[11px] font-black text-slate-400 uppercase tracking-wider block mb-1.5">도출 방식 선택</label>
                <div className="grid grid-cols-2 gap-2 p-1 bg-slate-100 rounded-xl">
                  <button
                    onClick=${() => setCalcMode('byAmount')}
                    className=${`py-2 text-xs font-bold rounded-lg transition-all ${calcMode === 'byAmount' ? 'bg-white text-indigo-600 shadow-sm' : 'text-slate-500'}`}
                  >
                    월 상환액 입력
                  </button>
                  <button
                    onClick=${() => setCalcMode('byMonths')}
                    className=${`py-2 text-xs font-bold rounded-lg transition-all ${calcMode === 'byMonths' ? 'bg-white text-indigo-600 shadow-sm' : 'text-slate-500'}`}
                  >
                    목표 기간(개월) 입력
                  </button>
                </div>
              </div>

              <!-- 모드별 인풋 -->
              ${calcMode === 'byAmount' ? html`
                <div>
                  <label className="text-[11px] font-black text-slate-400 uppercase tracking-wider block mb-1.5">매월 상환/납입액 (원)</label>
                  <div className="relative">
                    <input
                      type="number"
                      value=${inputMonthlyAmount || ''}
                      onChange=${(e) => setInputMonthlyAmount(Number(e.target.value))}
                      step="10000"
                      className="w-full p-3 pr-8 rounded-xl bg-slate-50 border border-slate-200 text-sm font-black font-mono text-indigo-600 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                    />
                    <span className="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400">원</span>
                  </div>
                  <div className="flex gap-1.5 mt-2">
                    ${[100000, 200000, 300000, 500000].map(amt => html`
                      <button
                        key=${amt}
                        onClick=${() => setInputMonthlyAmount(amt)}
                        className="text-[10px] bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 px-2 py-1 rounded-lg font-bold text-slate-500 transition-colors"
                      >
                        ${amt / 10000}만
                      </button>
                    `)}
                  </div>
                </div>
              ` : html`
                <div>
                  <label className="text-[11px] font-black text-slate-400 uppercase tracking-wider block mb-1.5">목표 상환 완료 기간</label>
                  <div className="relative">
                    <input
                      type="number"
                      value=${inputTargetMonths || ''}
                      onChange=${(e) => setInputTargetMonths(Number(e.target.value))}
                      className="w-full p-3 pr-10 rounded-xl bg-slate-50 border border-slate-200 text-sm font-black font-mono text-indigo-600 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                    />
                    <span className="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400">개월</span>
                  </div>
                  <div className="flex gap-1.5 mt-2">
                    ${[3, 6, 12, 24, 36].map(m => html`
                      <button
                        key=${m}
                        onClick=${() => setInputTargetMonths(m)}
                        className="text-[10px] bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 px-2.5 py-1 rounded-lg font-bold text-slate-500 transition-colors"
                      >
                        ${m}개월
                      </button>
                    `)}
                  </div>
                </div>
              `}

              <!-- 연 이자율 및 시작월 -->
              <div className="grid grid-cols-2 gap-3 pt-2 border-t border-slate-100">
                <div>
                  <label className="text-[10px] font-black text-slate-400 uppercase block mb-1">상환 시작월</label>
                  <input
                    type="month"
                    value=${startMonth}
                    onChange=${(e) => setStartMonth(e.target.value)}
                    className="w-full p-2.5 rounded-xl bg-slate-50 border border-slate-200 text-xs font-bold text-slate-700 outline-none"
                  />
                </div>
                <div>
                  <label className="text-[10px] font-black text-slate-400 uppercase block mb-1">연 이자율 (%)</label>
                  <input
                    type="number"
                    step="0.1"
                    placeholder="0 (무이자)"
                    value=${annualInterestRate || ''}
                    onChange=${(e) => setAnnualInterestRate(Number(e.target.value))}
                    className="w-full p-2.5 rounded-xl bg-slate-50 border border-slate-200 text-xs font-bold text-slate-700 outline-none font-mono"
                  />
                </div>
              </div>
            </div>

            <!-- 오른쪽: 도출 결과 카드 & 스케줄 타임라인 표 -->
            <div className="lg:col-span-2 space-y-6">
              <!-- 결과 요약 박스 (3단 카드) -->
              <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div className="bg-gradient-to-br from-indigo-500 to-indigo-700 p-5 rounded-3xl text-white shadow-md">
                  <div className="flex items-center justify-between text-indigo-100 text-xs font-bold mb-2">
                    <span>완제 예정 시점</span>
                    <${Icon} name="calendar-check" className="w-4 h-4" />
                  </div>
                  <div className="text-2xl font-black tracking-tight font-mono">
                    ${repaymentSchedule.endYearMonth}
                  </div>
                  <div className="text-[11px] text-indigo-200 font-medium mt-1">
                    총 ${repaymentSchedule.totalMonths}개월 소요 (${Math.floor(repaymentSchedule.totalMonths / 12)}년 ${repaymentSchedule.totalMonths % 12}개월)
                  </div>
                </div>

                <div className="bg-white p-5 rounded-3xl border border-slate-200 shadow-sm">
                  <div className="flex items-center justify-between text-slate-400 text-xs font-bold mb-2">
                    <span>매월 필요 상환액</span>
                    <${Icon} name="coins" className="w-4 h-4 text-indigo-500" />
                  </div>
                  <div className="text-2xl font-black tracking-tight font-mono text-indigo-600">
                    ${repaymentSchedule.monthlyPay.toLocaleString()}원
                  </div>
                  <div className="text-[11px] text-slate-400 font-medium mt-1">
                    ${calcMode === 'byAmount' ? '고정 납입 금액 기준' : `목표 ${inputTargetMonths}개월 균등 상환`}
                  </div>
                </div>

                <div className="bg-white p-5 rounded-3xl border border-slate-200 shadow-sm">
                  <div className="flex items-center justify-between text-slate-400 text-xs font-bold mb-2">
                    <span>총 상환 예정액</span>
                    <${Icon} name="receipt" className="w-4 h-4 text-slate-400" />
                  </div>
                  <div className="text-2xl font-black tracking-tight font-mono text-slate-900">
                    ${repaymentSchedule.totalPaid.toLocaleString()}원
                  </div>
                  <div className="text-[11px] text-slate-400 font-medium mt-1">
                    원금 ${Math.abs(currentAccBalance).toLocaleString()}원 ${repaymentSchedule.totalInterest > 0 ? `+ 이자 ${repaymentSchedule.totalInterest.toLocaleString()}원` : '(무이자)'}
                  </div>
