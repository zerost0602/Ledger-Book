// --- 총계정원장 계정별 원장 드릴다운 & 누적잔액(Running Balance) 컴포넌트 ---
const AccountLedgerDetailView = ({ accountId, category, accounts, initialSetup, transactions, standardDate, dateRange, searchTerm, getAccountById, onBack, onEditTransaction, onPrint }) => {
  const [sortOrder, setSortOrder] = useState('desc'); // 'desc' | 'asc'
  const account = getAccountById(accountId);
  const isCreditNormal = category === 'liabilities' || category === 'revenue';

  const categoryBadge = {
    assets: { label: '자산', cls: 'bg-blue-100 text-blue-700' },
    liabilities: { label: '부채/자본', cls: 'bg-red-100 text-red-700' },
    revenue: { label: '수익', cls: 'bg-emerald-100 text-emerald-700' },
    expenses: { label: '비용', cls: 'bg-orange-100 text-orange-700' }
  }[category] || { label: '계정', cls: 'bg-slate-100 text-slate-700' };

  const ledgerData = useMemo(() => {
    const effectiveEnd = dateRange.end || standardDate || '9999-12-31';
    const effectiveStart = dateRange.start || '';

    // 기초 설정 잔액 반영 (자산/부채/자본 계정)
    let rawOpening = 0;
    if (category === 'assets' || category === 'liabilities') {
      (initialSetup.debits || []).forEach(d => {
        if (String(d.accountId) === String(accountId)) rawOpening += Number(d.amount || 0);
      });
      (initialSetup.credits || []).forEach(c => {
        if (String(c.accountId) === String(accountId)) rawOpening -= Number(c.amount || 0);
      });
    }

    // 해당 계정이 포함된 기준일 이하 전체 거래를 시간순 정렬 (원장 누적잔액 정합성 유지)
    const accTxs = transactions
      .filter(t => {
        if (t.date > effectiveEnd) return false;
        return (
          (t.debits || []).some(d => String(d.accountId) === String(accountId)) ||
          (t.credits || []).some(c => String(c.accountId) === String(accountId))
        );
      })
      .sort((a, b) => a.date.localeCompare(b.date) || String(a.id).localeCompare(String(b.id)));

    let runningRaw = rawOpening;
    let openingDisplayBalance = isCreditNormal ? -rawOpening : rawOpening;
    let periodDebitTotal = 0;
    let periodCreditTotal = 0;
    const rows = [];

    accTxs.forEach(tx => {
      const dAmt = (tx.debits || [])
        .filter(d => String(d.accountId) === String(accountId))
        .reduce((s, d) => s + Number(d.amount || 0), 0);
      const cAmt = (tx.credits || [])
        .filter(c => String(c.accountId) === String(accountId))
        .reduce((s, c) => s + Number(c.amount || 0), 0);
      const tags = [
        ...(tx.debits || []).filter(d => String(d.accountId) === String(accountId) && d.tag).map(d => d.tag),
        ...(tx.credits || []).filter(c => String(c.accountId) === String(accountId) && c.tag).map(c => c.tag)
      ];

      if (effectiveStart && tx.date < effectiveStart) {
        runningRaw += (dAmt - cAmt);
        openingDisplayBalance = isCreditNormal ? -runningRaw : runningRaw;
        return;
      }

      runningRaw += (dAmt - cAmt);
      const displayBal = isCreditNormal ? -runningRaw : runningRaw;

      if (matchesTransactionSearch(tx, searchTerm, getAccountById)) {
        periodDebitTotal += dAmt;
        periodCreditTotal += cAmt;
        rows.push({
          tx,
          date: tx.date,
          vendor: tx.vendor || '',
          memo: tx.memo || '',
          tags: [...new Set(tags)],
          debit: dAmt,
          credit: cAmt,
          runningBalance: displayBal
        });
      }
    });

    const endingDisplayBalance = isCreditNormal ? -runningRaw : runningRaw;
    const displayRows = sortOrder === 'desc' ? [...rows].reverse() : rows;

    return {
      openingBalance: openingDisplayBalance,
      periodDebitTotal,
      periodCreditTotal,
      endingBalance: endingDisplayBalance,
      rows: displayRows
    };
  }, [accountId, category, initialSetup, transactions, standardDate, dateRange, searchTerm, sortOrder, isCreditNormal, getAccountById]);

  return html`
    <${Card}>
      <div className="p-4 sm:p-5 border-b bg-slate-50 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div className="flex items-center gap-2.5">
          <button
            onClick=${onBack}
            className="p-2 rounded-xl bg-white border border-slate-200 hover:bg-slate-100 text-slate-600 transition-colors shadow-xs"
            title="계정 목록으로 돌아가기"
          >
            <${Icon} name="arrow-left" className="w-4 h-4" />
          </button>
          <div>
            <div className="flex items-center gap-2">
              <span className=${`px-2 py-0.5 rounded-md text-[10px] font-black ${categoryBadge.cls}`}>${categoryBadge.label}</span>
              <h3 className="font-black text-base sm:text-lg text-slate-800">${account.name} 원장</h3>
              <span className="text-xs font-bold text-slate-400">(${ledgerData.rows.length}건)</span>
            </div>
            <p className="text-[11px] text-slate-400 font-medium mt-0.5">
              ${isCreditNormal ? '대변(+) 증가 / 차변(-) 감소 계정' : '차변(+) 증가 / 대변(-) 감소 계정'} · 행을 클릭하면 전표를 수정할 수 있습니다.
            </p>
          </div>
        </div>

        <div className="flex items-center gap-2 self-end sm:self-auto">
          <div className="flex bg-slate-200/70 p-0.5 rounded-xl text-xs font-bold">
            <button
              onClick=${() => setSortOrder('desc')}
              className=${`px-2.5 py-1 rounded-lg transition-all ${sortOrder === 'desc' ? 'bg-white text-indigo-600 shadow-xs' : 'text-slate-500'}`}
            >최신순</button>
            <button
              onClick=${() => setSortOrder('asc')}
              className=${`px-2.5 py-1 rounded-lg transition-all ${sortOrder === 'asc' ? 'bg-white text-indigo-600 shadow-xs' : 'text-slate-500'}`}
            >과거순</button>
          </div>
          <button onClick=${onPrint} className="text-xs bg-white border border-slate-200 text-indigo-600 hover:bg-indigo-50 px-3 py-1.5 rounded-xl font-bold flex items-center gap-1.5 shadow-xs">
            <${Icon} name="printer" className="w-3.5 h-3.5" />
            <span>원장 인쇄</span>
          </button>
        </div>
      </div>

      <!-- 요약 바: 기초/이월 잔액 | 기간 차변 | 기간 대변 | 기말(누적) 잔액 -->
      <div className="grid grid-cols-2 sm:grid-cols-4 gap-2.5 p-4 bg-white border-b border-slate-100 text-xs">
        <div className="p-3 rounded-xl bg-slate-50 border border-slate-100">
          <div className="text-[10px] font-black text-slate-400 uppercase mb-0.5">${dateRange.start ? '기간 전 이월잔액' : '기초 잔액'}</div>
          <${MoneyText} amount=${ledgerData.openingBalance} className="text-sm" />
        </div>
        <div className="p-3 rounded-xl bg-indigo-50/50 border border-indigo-100">
          <div className="text-[10px] font-black text-indigo-400 uppercase mb-0.5">기간 차변 합계</div>
          <${MoneyText} amount=${ledgerData.periodDebitTotal} colorClass="text-indigo-600" className="text-sm" />
        </div>
        <div className="p-3 rounded-xl bg-rose-50/50 border border-rose-100">
          <div className="text-[10px] font-black text-rose-400 uppercase mb-0.5">기간 대변 합계</div>
          <${MoneyText} amount=${ledgerData.periodCreditTotal} colorClass="text-rose-500" className="text-sm" />
        </div>
        <div className="p-3 rounded-xl bg-emerald-50/60 border border-emerald-100">
          <div className="text-[10px] font-black text-emerald-600 uppercase mb-0.5">기말(현재) 잔액</div>
          <${MoneyText} amount=${ledgerData.endingBalance} colorClass=${ledgerData.endingBalance < 0 ? 'text-rose-600' : 'text-emerald-700'} className="text-sm" />
        </div>
      </div>

      <div className="overflow-x-auto">
        <table className="w-full text-left border-collapse text-xs">
          <thead className="bg-slate-50 text-slate-400 text-[10px] font-black uppercase tracking-wider border-b border-slate-200">
            <tr>
              <th className="py-2.5 px-3 sm:px-4 w-24 sm:w-28 whitespace-nowrap">일자</th>
              <th className="py-2.5 px-3 sm:px-4">거래처 / 거래내용</th>
              <th className="py-2.5 px-3 sm:px-4 text-right w-24 sm:w-32 whitespace-nowrap">차변 (Debit)</th>
              <th className="py-2.5 px-3 sm:px-4 text-right w-24 sm:w-32 whitespace-nowrap">대변 (Credit)</th>
              <th className="py-2.5 px-3 sm:px-4 text-right w-28 sm:w-36 whitespace-nowrap">누적잔액</th>
            </tr>
          </thead>
          <tbody className="divide-y divide-slate-100">
            ${ledgerData.rows.length === 0 ? html`
              <tr>
                <td colSpan="5" className="py-10 text-center text-slate-400 font-medium">해당 조건의 원장 거래 내역이 없습니다.</td>
              </tr>
            ` : ledgerData.rows.map((row) => html`
              <tr
                key=${row.tx.id}
                onClick=${() => onEditTransaction(row.tx)}
                className="hover:bg-indigo-50/50 active:bg-indigo-100/50 cursor-pointer transition-colors"
              >
                <td className="py-2.5 px-3 sm:px-4 font-mono text-slate-500 whitespace-nowrap">${row.date}</td>
                <td className="py-2.5 px-3 sm:px-4 font-bold text-slate-700">
                  <div className="flex flex-wrap items-center gap-1.5">
                    ${row.vendor && html`<span className="bg-slate-100 text-slate-600 border border-slate-200 text-[10px] px-1.5 py-0.5 rounded font-extrabold">${row.vendor}</span>`}
                    <span>${row.memo || '거래내용 없음'}</span>
                    ${row.tags.map(tg => html`<span key=${tg} className="text-[10px] text-indigo-500 bg-indigo-50 px-1.5 py-0.5 rounded">#${tg}</span>`)}
                  </div>
                </td>
                <td className="py-2.5 px-3 sm:px-4 text-right font-mono whitespace-nowrap">
                  ${row.debit > 0 ? html`<span className="font-bold text-indigo-600">${row.debit.toLocaleString()}원</span>` : html`<span className="text-slate-300">-</span>`}
                </td>
                <td className="py-2.5 px-3 sm:px-4 text-right font-mono whitespace-nowrap">
                  ${row.credit > 0 ? html`<span className="font-bold text-rose-500">${row.credit.toLocaleString()}원</span>` : html`<span className="text-slate-300">-</span>`}
                </td>
                <td className="py-2.5 px-3 sm:px-4 text-right font-mono whitespace-nowrap bg-slate-50/60">
                  <${MoneyText} amount=${row.runningBalance} className="text-xs" />
                </td>
              </tr>
            `)}
          </tbody>
        </table>
      </div>
    <//>
  `;
};

// --- 독립 전표 입력/수정 모달 컴포넌트 (모달 상태 분리로 배경 리렌더링 차단) ---
const EntryModal = ({ isOpen, onClose, editingTransaction, defaultDate, accounts, getAccountById, onSave, onDeleteRequest }) => {
  const [entryRows, setEntryRows] = useState({
    date: defaultDate || getLocalTodayStr(),
    debits: [{ accountId: '', amount: 0, tag: '' }],
    credits: [{ accountId: '', amount: 0, tag: '' }],
    vendor: '',
    memo: ''
  });
  const [activePicker, setActivePicker] = useState(null);
  const [isSavingEntry, setIsSavingEntry] = useState(false);
  const [focusedRow, setFocusedRow] = useState({ type: 'debits', index: 0 });

  useEffect(() => {
    if (!isOpen) return;
    if (editingTransaction) {
      setEntryRows({
        date: editingTransaction.date || getLocalTodayStr(),
        debits: (editingTransaction.debits && editingTransaction.debits.length > 0)
          ? editingTransaction.debits.map(d => ({ ...d }))
          : [{ accountId: '', amount: 0, tag: '' }],
        credits: (editingTransaction.credits && editingTransaction.credits.length > 0)
          ? editingTransaction.credits.map(c => ({ ...c }))
          : [{ accountId: '', amount: 0, tag: '' }],
        vendor: editingTransaction.vendor || '',
        memo: editingTransaction.memo || ''
      });
    } else {
      setEntryRows({
        date: defaultDate || getLocalTodayStr(),
        debits: [{ accountId: '', amount: 0, tag: '' }],
        credits: [{ accountId: '', amount: 0, tag: '' }],
        vendor: '',
        memo: ''
      });
    }
    setFocusedRow({ type: 'debits', index: 0 });
    setActivePicker(null);
  }, [isOpen, editingTransaction, defaultDate]);

  const totalDebitSum = useMemo(() => (entryRows.debits || []).reduce((s, r) => s + Number(r.amount || 0), 0), [entryRows.debits]);
  const totalCreditSum = useMemo(() => (entryRows.credits || []).reduce((s, r) => s + Number(r.amount || 0), 0), [entryRows.credits]);

  const entryValidation = useMemo(() => {
    const debits = entryRows.debits || [];
    const credits = entryRows.credits || [];

    const hasUnassignedAmount =
      debits.some(d => !d.accountId && Number(d.amount || 0) !== 0) ||
      credits.some(c => !c.accountId && Number(c.amount || 0) !== 0);

    const hasNegativeAmount =
      debits.some(d => Number(d.amount || 0) < 0) ||
      credits.some(c => Number(c.amount || 0) < 0);

    const hasMissingAmount =
      debits.some(d => Boolean(d.accountId) && Number(d.amount || 0) <= 0) ||
      credits.some(c => Boolean(c.accountId) && Number(c.amount || 0) <= 0);

    const validDebits = debits.filter(d => Boolean(d.accountId) && Number(d.amount || 0) > 0);
    const validCredits = credits.filter(c => Boolean(c.accountId) && Number(c.amount || 0) > 0);

    const validDebitSum = validDebits.reduce((s, d) => s + Number(d.amount || 0), 0);
    const validCreditSum = validCredits.reduce((s, c) => s + Number(c.amount || 0), 0);

    const hasDate = Boolean(entryRows.date && String(entryRows.date).trim());
    const hasMemo = Boolean(entryRows.memo && String(entryRows.memo).trim());

    let status = 'valid';
    let message = '✓ 입력조건 충족 (차대일치)';
    let badgeClass = 'bg-emerald-500 text-white';

    if (!hasDate) {
      status = 'no_date';
      message = '⚠ 전표 날짜 입력 필요';
      badgeClass = 'bg-amber-100 text-amber-800 border border-amber-200';
    } else if (hasNegativeAmount) {
      status = 'negative_amount';
      message = '⚠ 음수 금액 입력 불가';
      badgeClass = 'bg-rose-100 text-rose-700 border border-rose-200';
    } else if (hasUnassignedAmount) {
      status = 'unassigned_account';
      message = '⚠ 계정과목 선택 필요';
      badgeClass = 'bg-rose-100 text-rose-700 border border-rose-200 animate-pulse';
    } else if (hasMissingAmount) {
      status = 'missing_amount';
      message = '⚠ 거래금액 입력 필요';
      badgeClass = 'bg-amber-100 text-amber-800 border border-amber-200';
    } else if (validDebits.length === 0 || validCredits.length === 0) {
      status = 'empty_entries';
      message = '계정 선택 및 금액 입력 필요';
      badgeClass = 'bg-slate-200 text-slate-500';
    } else if (totalDebitSum !== totalCreditSum || validDebitSum !== validCreditSum || validDebitSum <= 0) {
      status = 'unbalanced';
      message = `불일치 (${Math.abs(totalDebitSum - totalCreditSum).toLocaleString()}원 차이)`;
      badgeClass = 'bg-rose-100 text-rose-700 border border-rose-200';
    } else if (!hasMemo) {
      status = 'missing_memo';
      message = '⚠ 거래내용 입력 필요';
      badgeClass = 'bg-amber-100 text-amber-800 border border-amber-200 animate-pulse';
    }

    return {
      isValid: status === 'valid',
      status,
      message,
      badgeClass,
      validDebits,
      validCredits
    };
  }, [entryRows, totalDebitSum, totalCreditSum]);

  const handleUpdateRow = (type, index, field, value) => {
    setEntryRows(prev => {
      const nextRows = [...prev[type]];
      nextRows[index] = { ...nextRows[index], [field]: value };
      return { ...prev, [type]: nextRows };
    });
  };

  // 계정 선택 시 반대편 합계가 더 크고 현재 행 금액이 0이면 부족 차액을 자동으로 채워줌
  const handlePickAccount = (id) => {
    if (!activePicker) return;
    const { type, index } = activePicker;
    setEntryRows(prev => {
      const nextRows = [...prev[type]];
      const targetRow = nextRows[index];
      const curSideSum = prev[type].reduce((s, r) => s + Number(r.amount || 0), 0);
      const otherSide = type === 'debits' ? 'credits' : 'debits';
      const otherSideSum = prev[otherSide].reduce((s, r) => s + Number(r.amount || 0), 0);
      let nextAmount = Number(targetRow.amount || 0);
      if (nextAmount === 0 && otherSideSum > curSideSum) {
        nextAmount = otherSideSum - curSideSum;
      }
      nextRows[index] = { ...targetRow, accountId: id, tag: '', amount: nextAmount };
      return { ...prev, [type]: nextRows };
    });
    setFocusedRow({ type, index });
    setActivePicker(null);
  };

  // 원클릭 차액 자동 채우기 핸들러
  const handleAutoFillDiff = (deficientSide) => {
    const diff = deficientSide === 'debits'
      ? totalCreditSum - totalDebitSum
      : totalDebitSum - totalCreditSum;
    if (diff <= 0) return;

    setEntryRows(prev => {
      const rows = [...prev[deficientSide]];
      const zeroIdx = rows.findIndex(r => Number(r.amount || 0) === 0);
      if (zeroIdx >= 0) {
        rows[zeroIdx] = { ...rows[zeroIdx], amount: diff };
        setFocusedRow({ type: deficientSide, index: zeroIdx });
      } else {
        const lastIdx = rows.length - 1;
        rows[lastIdx] = { ...rows[lastIdx], amount: Number(rows[lastIdx].amount || 0) + diff };
        setFocusedRow({ type: deficientSide, index: lastIdx });
      }
      return { ...prev, [deficientSide]: rows };
    });
  };

  // 빠른 금액 단위 버튼 (+1천, +5천, +1만, +5만, +10만, 초기화)
  const handleQuickAddAmount = (delta) => {
    setEntryRows(prev => {
      const { type, index } = focusedRow;
      const rows = prev[type] ? [...prev[type]] : null;
      if (!rows || !rows[index]) return prev;
      const nextAmt = delta === 0 ? 0 : Math.max(0, Number(rows[index].amount || 0) + delta);
      rows[index] = { ...rows[index], amount: nextAmt };
      return { ...prev, [type]: rows };
    });
  };

  const handleSubmit = async () => {
    if (!entryValidation.isValid) {
      alert(`전표를 저장할 수 없습니다: ${entryValidation.message}`);
      return;
    }
    setIsSavingEntry(true);
    try {
      const newTransaction = {
        id: editingTransaction ? editingTransaction.id : `T-${Date.now()}`,
        date: entryRows.date,
        debits: entryValidation.validDebits.map(d => ({ accountId: d.accountId, amount: Number(d.amount), tag: d.tag || '' })),
        credits: entryValidation.validCredits.map(c => ({ accountId: c.accountId, amount: Number(c.amount), tag: c.tag || '' })),
        vendor: (entryRows.vendor || '').trim(),
        memo: entryRows.memo.trim()
      };
      await onSave(newTransaction);
      onClose();
    } finally {
      setIsSavingEntry(false);
    }
  };

  if (!isOpen) return null;

  return html`
    <${Modal} isOpen=${isOpen} onClose=${onClose} title=${editingTransaction ? '전표 수정' : '전표 입력'} maxWidth="max-w-6xl" zIndex="z-[120]">
      <div className="flex flex-col lg:flex-row gap-4 sm:gap-6 text-slate-800">
        <div className="w-full lg:w-48 shrink-0 bg-slate-50 p-4 rounded-2xl border h-fit shadow-inner">
          <label className="block text-[9px] font-black text-slate-400 uppercase mb-2 text-center lg:text-left">전표 날짜</label>
          <input type="date" className="w-full p-2.5 rounded-xl border text-xs font-bold outline-none mb-3 shadow-sm bg-white text-slate-700" value=${entryRows.date} onChange=${(e) => setEntryRows(prev => ({ ...prev, date: e.target.value }))} />
          ${editingTransaction && html`
            <button onClick=${() => onDeleteRequest(editingTransaction)} className="w-full p-3 bg-red-50 text-red-500 rounded-xl font-bold text-[11px] hover:bg-red-500 hover:text-white transition-all shadow-sm flex items-center justify-center gap-2">
              <${Icon} name="trash-2" className="w-3.5 h-3.5" />삭제하기
            </button>
          `}
        </div>

        <div className="flex-1 space-y-3 pb-20 sm:pb-0">
          <!-- 빠른 금액 단위 입력 툴바 -->
          <div className="flex flex-wrap items-center justify-between gap-2 bg-slate-50 px-3 py-2 rounded-xl border border-slate-200/80 text-xs">
            <span className="text-[11px] font-bold text-slate-500">
              선택 행 금액 빠른입력:
              <strong className=${`ml-1 ${focusedRow.type === 'debits' ? 'text-indigo-600' : 'text-rose-500'}`}>
                ${focusedRow.type === 'debits' ? '차변' : '대변'} #${focusedRow.index + 1}
              </strong>
            </span>
            <div className="flex flex-wrap items-center gap-1">
              ${[
                { label: '+1천', val: 1000 },
                { label: '+5천', val: 5000 },
                { label: '+1만', val: 10000 },
                { label: '+5만', val: 50000 },
                { label: '+10만', val: 100000 },
                { label: '0원', val: 0 }
              ].map(btn => html`
                <button
                  key=${btn.label}
                  type="button"
                  onClick=${() => handleQuickAddAmount(btn.val)}
                  className=${`px-2 py-1 rounded-lg text-[11px] font-extrabold border transition-all active:scale-95 ${btn.val === 0 ? 'bg-white text-slate-400 border-slate-200 hover:text-rose-500' : 'bg-white text-slate-700 border-slate-200 hover:bg-indigo-50 hover:text-indigo-600 hover:border-indigo-200'}`}
                >
                  ${btn.label}
                </button>
              `)}
            </div>
          </div>

          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- 차변 (Debit) -->
            <div className="bg-white rounded-2xl border shadow-sm flex flex-col overflow-hidden">
              <div className="bg-indigo-600 text-white p-2 font-black text-center text-[10px] uppercase">Debit (차변)</div>
              <div className="p-3 space-y-2 min-h-[120px] sm:min-h-[230px] flex-1">
                ${entryRows.debits.map((r, i) => {
                  const account = r.accountId ? getAccountById(r.accountId) : null;
                  const availableTags = [...(account?.tags || [])];
                  if (r.tag && !availableTags.includes(r.tag)) availableTags.push(r.tag);
                  const isMissingAcc = (!r.accountId || account?.isUnknown) && Number(r.amount || 0) !== 0;
                  const isMissingAmt = Boolean(r.accountId) && Number(r.amount || 0) <= 0;
                  const isFocused = focusedRow.type === 'debits' && focusedRow.index === i;
                  return html`
                    <div key=${i} className="flex gap-1.5 items-center animate-in slide-in-from-left-2">
                      <button
                        type="button"
                        onClick=${() => { setFocusedRow({ type: 'debits', index: i }); setActivePicker({ type: 'debits', index: i }); }}
                        className=${`flex-1 min-w-[70px] p-2.5 rounded-lg text-[11px] font-bold border text-left truncate active:bg-indigo-50 transition-colors ${isMissingAcc ? 'bg-rose-50 text-rose-600 border-rose-300 ring-1 ring-rose-200' : account ? 'bg-slate-50 text-slate-800 border-slate-200' : 'bg-slate-50 text-slate-400 border-slate-100'}`}
                      >
                        ${account ? account.name : (isMissingAcc ? '⚠ 계정 필수 선택' : '계정 선택')}
                      </button>
                      <select
                        value=${r.tag || ''}
                        onChange=${(e) => handleUpdateRow('debits', i, 'tag', e.target.value)}
                        disabled=${!r.accountId}
                        className="w-24 sm:w-28 p-2 rounded-lg bg-white border border-slate-200 text-xs font-bold outline-none text-slate-700 disabled:opacity-50"
                      >
                        <option value="">태그 없음</option>
                        ${availableTags.map(t => html`<option key=${t} value=${t}>${t}</option>`)}
                      </select>
                      <${MoneyInput}
                        className=${`w-24 sm:w-28 p-2 rounded-lg text-right font-black border text-xs outline-none transition-colors ${Number(r.amount || 0) < 0 ? 'bg-rose-50 border-rose-300 text-rose-600' : isMissingAmt ? 'bg-amber-50/40 border-amber-300 text-slate-800' : isFocused ? 'bg-white border-indigo-400 ring-2 ring-indigo-100 text-indigo-700' : 'bg-white border-slate-200 text-slate-800'}`}
                        placeholder="금액 입력"
                        value=${r.amount || 0}
                        onFocus=${() => setFocusedRow({ type: 'debits', index: i })}
                        onChange=${(val) => handleUpdateRow('debits', i, 'amount', val)}
                      />
                      <button type="button" onClick=${() => { const n = [...entryRows.debits]; if (n.length > 1) { n.splice(i, 1); setEntryRows(prev => ({ ...prev, debits: n })); setFocusedRow({ type: 'debits', index: Math.max(0, i - 1) }); } }} className="text-slate-300 hover:text-red-500 p-1"><${TrashIcon}/></button>
                    </div>
                  `;
                })}
                <button type="button" onClick=${() => { const nextIdx = entryRows.debits.length; setEntryRows(prev => ({ ...prev, debits: [...prev.debits, { accountId: '', amount: 0, tag: '' }] })); setFocusedRow({ type: 'debits', index: nextIdx }); }} className="w-full p-2 mt-1 text-[10px] font-black text-indigo-500 border border-dashed border-indigo-200 rounded-lg hover:bg-indigo-50">+ 행 추가</button>
              </div>
              <div className="bg-slate-50 p-2.5 flex justify-between items-center font-black border-t text-xs sm:text-base gap-2">
                <span className="text-[9px] uppercase text-slate-400">Total Debit</span>
                ${totalCreditSum > totalDebitSum && html`
                  <button
                    type="button"
                    onClick=${() => handleAutoFillDiff('debits')}
                    className="text-[10px] sm:text-xs text-indigo-700 hover:bg-indigo-600 hover:text-white font-black px-2.5 py-1 rounded-lg bg-indigo-50 border border-indigo-200 transition-all active:scale-95"
                  >
                    ${(totalCreditSum - totalDebitSum).toLocaleString()}원 차액 채우기
                  </button>
                `}
                <span className="font-mono text-indigo-600 font-black">${totalDebitSum.toLocaleString()}원</span>
              </div>
            </div>

            <!-- 대변 (Credit) -->
            <div className="bg-white rounded-2xl border shadow-sm flex flex-col overflow-hidden">
              <div className="bg-red-500 text-white p-2 font-black text-center text-[10px] uppercase">Credit (대변)</div>
              <div className="p-3 space-y-2 min-h-[120px] sm:min-h-[230px] flex-1">
                ${entryRows.credits.map((r, i) => {
                  const account = r.accountId ? getAccountById(r.accountId) : null;
                  const availableTags = [...(account?.tags || [])];
                  if (r.tag && !availableTags.includes(r.tag)) availableTags.push(r.tag);
                  const isMissingAcc = (!r.accountId || account?.isUnknown) && Number(r.amount || 0) !== 0;
                  const isMissingAmt = Boolean(r.accountId) && Number(r.amount || 0) <= 0;
                  const isFocused = focusedRow.type === 'credits' && focusedRow.index === i;
                  return html`
                    <div key=${i} className="flex gap-1.5 items-center animate-in slide-in-from-right-2">
                      <button
                        type="button"
                        onClick=${() => { setFocusedRow({ type: 'credits', index: i }); setActivePicker({ type: 'credits', index: i }); }}
                        className=${`flex-1 min-w-[70px] p-2.5 rounded-lg text-[11px] font-bold border text-left truncate active:bg-red-50 transition-colors ${isMissingAcc ? 'bg-rose-50 text-rose-600 border-rose-300 ring-1 ring-rose-200' : account ? 'bg-slate-50 text-slate-800 border-slate-200' : 'bg-slate-50 text-slate-400 border-slate-100'}`}
                      >
                        ${account ? account.name : (isMissingAcc ? '⚠ 계정 필수 선택' : '계정 선택')}
                      </button>
                      <select
                        value=${r.tag || ''}
                        onChange=${(e) => handleUpdateRow('credits', i, 'tag', e.target.value)}
                        disabled=${!r.accountId}
                        className="w-24 sm:w-28 p-2 rounded-lg bg-white border border-slate-200 text-xs font-bold outline-none text-slate-700 disabled:opacity-50"
                      >
                        <option value="">태그 없음</option>
                        ${availableTags.map(t => html`<option key=${t} value=${t}>${t}</option>`)}
                      </select>
                      <${MoneyInput}
                        className=${`w-24 sm:w-28 p-2 rounded-lg text-right font-black border text-xs outline-none transition-colors ${Number(r.amount || 0) < 0 ? 'bg-rose-50 border-rose-300 text-rose-600' : isMissingAmt ? 'bg-amber-50/40 border-amber-300 text-slate-800' : isFocused ? 'bg-white border-rose-400 ring-2 ring-rose-100 text-rose-600' : 'bg-white border-slate-200 text-slate-800'}`}
                        placeholder="금액 입력"
                        value=${r.amount || 0}
                        onFocus=${() => setFocusedRow({ type: 'credits', index: i })}
                        onChange=${(val) => handleUpdateRow('credits', i, 'amount', val)}
                      />
                      <button type="button" onClick=${() => { const n = [...entryRows.credits]; if (n.length > 1) { n.splice(i, 1); setEntryRows(prev => ({ ...prev, credits: n })); setFocusedRow({ type: 'credits', index: Math.max(0, i - 1) }); } }} className="text-slate-300 hover:text-red-500 p-1"><${TrashIcon}/></button>
                    </div>
                  `;
                })}
                <button type="button" onClick=${() => { const nextIdx = entryRows.credits.length; setEntryRows(prev => ({ ...prev, credits: [...prev.credits, { accountId: '', amount: 0, tag: '' }] })); setFocusedRow({ type: 'credits', index: nextIdx }); }} className="w-full p-2 mt-1 text-[10px] font-black text-red-500 border border-dashed border-red-200 rounded-lg hover:bg-red-50">+ 행 추가</button>
              </div>
              <div className="bg-slate-50 p-2.5 flex justify-between items-center font-black border-t text-xs sm:text-base gap-2">
                <span className="text-[9px] uppercase text-slate-400">Total Credit</span>
                ${totalDebitSum > totalCreditSum && html`
                  <button
                    type="button"
                    onClick=${() => handleAutoFillDiff('credits')}
                    className="text-[10px] sm:text-xs text-rose-600 hover:bg-rose-500 hover:text-white font-black px-2.5 py-1 rounded-lg bg-rose-50 border border-rose-200 transition-all active:scale-95"
                  >
                    ${(totalDebitSum - totalCreditSum).toLocaleString()}원 차액 채우기
                  </button>
                `}
                <span className="font-mono text-red-500 font-black">${totalCreditSum.toLocaleString()}원</span>
              </div>
            </div>
          </div>

          <div className="bg-slate-50 p-3 sm:p-4 rounded-2xl border flex flex-col gap-3 shadow-inner">
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label className="block text-[9px] font-black text-slate-400 uppercase mb-1 ml-1">거래처 (Counterparty)</label>
                <input type="text" className="w-full bg-white p-2.5 rounded-xl border border-slate-200 outline-none font-bold placeholder:text-slate-300 text-slate-700 text-xs sm:text-sm" placeholder="거래처 입력 (예: 스타벅스, 쿠팡)" value=${entryRows.vendor || ''} onChange=${(e) => setEntryRows(prev => ({ ...prev, vendor: e.target.value }))} />
              </div>
              <div>
                <label className="block text-[9px] font-black text-slate-400 uppercase mb-1 ml-1">
                  거래 내용 (Memo) <span className="text-rose-500">*필수</span>
                </label>
                <input
                  type="text"
                  className=${`w-full bg-white p-2.5 rounded-xl border outline-none font-bold placeholder:text-slate-300 text-slate-700 text-xs sm:text-sm transition-all ${entryValidation.status === 'missing_memo' ? 'border-amber-400 ring-2 ring-amber-100' : 'border-slate-200 focus:border-indigo-500'}`}
                  placeholder="거래 내용을 반드시 입력하세요 (예: 점심 식비 결제)"
                  value=${entryRows.memo || ''}
                  onChange=${(e) => setEntryRows(prev => ({ ...prev, memo: e.target.value }))}
                />
              </div>
            </div>
            <div className="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 sm:gap-4">
              <span className=${`px-4 py-2 rounded-full text-[10px] sm:text-xs font-black text-center shadow-sm ${entryValidation.badgeClass}`}>
                ${entryValidation.message}
              </span>
              <button
                type="button"
                onClick=${handleSubmit}
                disabled=${isSavingEntry || !entryValidation.isValid}
                className="flex-1 bg-indigo-600 hover:bg-indigo-700 disabled:bg-slate-300 disabled:cursor-not-allowed text-white px-6 py-3 rounded-xl font-black shadow-lg transition-all active:scale-95 text-xs sm:text-sm whitespace-nowrap"
              >
                ${isSavingEntry ? html`
                  <span className="flex items-center justify-center gap-2">
                    <${Icon} name="loader-2" className="w-4 h-4 animate-spin" /> 저장 중...
                  </span>
                ` : '전표 저장하기'}
              </button>
            </div>
          </div>
        </div>
      </div>

      <${Modal} isOpen=${activePicker !== null} onClose=${() => setActivePicker(null)} title="계정과목 선택" maxWidth="max-w-4xl" zIndex="z-[150]">
        <${AccountGridPicker} accounts=${accounts} onPick=${handlePickAccount} />
      <//>
    <//>
  `;
};

// --- 독립 환경설정 모달 컴포넌트 (모달 상태 분리 + 모바일 고정/변동 원탭 전환 + 일괄 이관) ---
const SettingsModal = ({
  isOpen,
  onClose,
  initialSetup,
  accounts,
  transactions,
  flatAccounts,
  orphanAccountBalances,
  retainedEarningsId,
  getAccountById,
  setData,
  isDirty,
  setIsDirty,
  saveSettingsData,
  saveTransactionsBatch,
  setConfirmDialog,
  setStatusMessage
}) => {
  const [settingsTab, setSettingsTab] = useState('equity');
  const [addingToCategory, setAddingToCategory] = useState(null);
  const [draggedAccountId, setDraggedAccountId] = useState(null);
  const [selectedAccountForTag, setSelectedAccountForTag] = useState(null);
  const [isAccountListOpen, setIsAccountListOpen] = useState(true);
  const [activeSetupPicker, setActiveSetupPicker] = useState(null);
  const [isLoadingReassign, setIsLoadingReassign] = useState(false);

  const setupTotalDebits = useMemo(() => (initialSetup.debits || []).reduce((s, d) => s + Number(d.amount || 0), 0), [initialSetup.debits]);
  const setupTotalOtherCredits = useMemo(() => (initialSetup.credits || []).reduce((s, c) => s + Number(c.amount || 0), 0), [initialSetup.credits]);
  const calculatedInitialCapital = useMemo(() => setupTotalDebits - setupTotalOtherCredits, [setupTotalDebits, setupTotalOtherCredits]);
  const retainedEarningsRow = useMemo(() => (initialSetup.credits || []).find(c => String(c.accountId) === String(retainedEarningsId)), [initialSetup.credits, retainedEarningsId]);
  const retainedEarningsAmount = retainedEarningsRow ? retainedEarningsRow.amount : 0;

  const handleSyncSettings = async () => {
    await saveSettingsData(initialSetup, accounts);
    setIsDirty(false);
    setStatusMessage({ type: 'success', text: '설정 저장 완료' });
  };

  const handleSetupAccountPick = (id) => {
    if (!activeSetupPicker) return;
    const { type, index } = activeSetupPicker;
    if (type === 'setupDebits') {
      setData(prev => {
        const n = [...(prev.initialSetup.debits || [])];
        n[index] = { ...n[index], accountId: id, tag: '' };
        return { ...prev, initialSetup: { ...prev.initialSetup, debits: n } };
      });
    } else if (type === 'setupCredits') {
      setData(prev => {
        const n = [...(prev.initialSetup.credits || [])];
        n[index] = { ...n[index], accountId: id, tag: '' };
        return { ...prev, initialSetup: { ...prev.initialSetup, credits: n } };
      });
    }
    setActiveSetupPicker(null);
    setIsDirty(true);
  };

  const handleAddAccount = (category, name) => {
    if (!name.trim()) return;
    setData(prev => {
      const newArr = [...(prev.accounts[category] || []), { id: Date.now().toString(), name: name.trim(), subtype: 'fixed' }];
      newArr.sort((a, b) => a.name.localeCompare(b.name, 'ko-KR'));
      return { ...prev, accounts: { ...prev.accounts, [category]: newArr } };
    });
    setIsDirty(true);
    setAddingToCategory(null);
  };

  const handleUpdateAccountName = (category, id, name) => {
    setData(prev => {
      const newArr = (prev.accounts[category] || []).map(a => String(a.id) === String(id) ? { ...a, name: name.trim() } : a);
      newArr.sort((a, b) => a.name.localeCompare(b.name, 'ko-KR'));
      return { ...prev, accounts: { ...prev.accounts, [category]: newArr } };
    });
    setIsDirty(true);
  };

  const handleDeleteAccount = (category, id) => {
    const targetAcc = getAccountById(id);
    const usedCount = transactions.filter(t =>
      (t.debits || []).some(d => String(d.accountId) === String(id)) ||
      (t.credits || []).some(c => String(c.accountId) === String(id))
    ).length;

    const message = usedCount > 0
      ? `'${targetAcc.name}' 계정과목을 사용하는 거래가 ${usedCount}건 존재합니다.\n삭제하더라도 기존 거래는 '미분류 계정'으로 안전하게 집계되어 차대 균형이 유지됩니다.\n정말 삭제하시겠습니까?`
      : `'${targetAcc.name}' 계정과목을 삭제하시겠습니까?`;

    setConfirmDialog({
      title: '계정과목 삭제 확인',
      message,
      onConfirm: () => {
        setData(prev => ({
          ...prev,
          accounts: {
            ...prev.accounts,
            [category]: (prev.accounts[category] || []).filter(a => String(a.id) !== String(id))
          }
        }));
        setIsDirty(true);
        setConfirmDialog(null);
      }
    });
  };

  const handleToggleSubtype = (type, accountId) => {
    setData(prev => ({
      ...prev,
      accounts: {
        ...prev.accounts,
        [type]: (prev.accounts[type] || []).map(a =>
          String(a.id) === String(accountId)
            ? { ...a, subtype: (a.subtype || 'fixed') === 'fixed' ? 'variable' : 'fixed' }
            : a
        )
      }
    }));
    setIsDirty(true);
  };

  const handleDragOver = (e) => e.preventDefault();
  const handleAccountDragStart = (id) => setDraggedAccountId(id);
  const handleSubtypeDrop = (subtype, type) => {
    if (!draggedAccountId) return;
    setData(prev => ({
      ...prev,
      accounts: {
        ...prev.accounts,
        [type]: (prev.accounts[type] || []).map(a => String(a.id) === String(draggedAccountId) ? { ...a, subtype } : a)
      }
    }));
    setIsDirty(true);
    setDraggedAccountId(null);
  };

  const handleAddTag = (category, accountId, tagText) => {
    const text = tagText.trim();
    if (!text) return;
    setData(prev => {
      const newAccounts = { ...prev.accounts };
      newAccounts[category] = (newAccounts[category] || []).map(a => {
        if (String(a.id) === String(accountId)) {
          const tags = a.tags || [];
          if (tags.includes(text)) return a;
          return { ...a, tags: [...tags, text] };
        }
        return a;
      });
      return { ...prev, accounts: newAccounts };
    });
    setIsDirty(true);
  };

  const handleRemoveTag = (category, accountId, tagText) => {
    setData(prev => {
      const newAccounts = { ...prev.accounts };
      newAccounts[category] = (newAccounts[category] || []).map(a => {
        if (String(a.id) === String(accountId)) {
          const tags = a.tags || [];
          return { ...a, tags: tags.filter(t => t !== tagText) };
        }
        return a;
      });
      return { ...prev, accounts: newAccounts };
    });
    setIsDirty(true);
  };

  const handleReassignOrphanAccount = async (oldId, targetAccountId) => {
    if (!oldId || !targetAccountId) return;
    setIsLoadingReassign(true);
    try {
      const newDebits = (initialSetup.debits || []).map(d => String(d.accountId) === String(oldId) ? { ...d, accountId: targetAccountId } : d);
      const newCredits = (initialSetup.credits || []).map(c => String(c.accountId) === String(oldId) ? { ...c, accountId: targetAccountId } : c);
      const newInitialSetup = { debits: newDebits, credits: newCredits };

      const updatedTxs = [];
      const newTransactions = transactions.map(tx => {
        let changed = false;
        const debits = (tx.debits || []).map(d => {
          if (String(d.accountId) === String(oldId)) { changed = true; return { ...d, accountId: targetAccountId }; }
          return d;
        });
        const credits = (tx.credits || []).map(c => {
          if (String(c.accountId) === String(oldId)) { changed = true; return { ...c, accountId: targetAccountId }; }
          return c;
        });
        const updated = { ...tx, debits, credits, memo: (tx.memo && String(tx.memo).trim()) ? tx.memo : '(이관 전표)' };
        if (changed) updatedTxs.push(updated);
        return updated;
      });

      setData(prev => ({ ...prev, initialSetup: newInitialSetup, transactions: newTransactions }));
      await saveSettingsData(newInitialSetup, accounts);
      if (updatedTxs.length > 0) {
        await saveTransactionsBatch(updatedTxs);
      }
      setStatusMessage({ type: 'success', text: `[${oldId}] 관련 거래 ${updatedTxs.length}건을 [${getAccountById(targetAccountId).name}] 계정으로 일괄 이관했습니다.` });
    } catch (err) {
      alert('이관 중 오류 발생: ' + err);
    } finally {
      setIsLoadingReassign(false);
    }
  };

  if (!isOpen) return null;

  return html`
    <${Modal} isOpen=${isOpen} onClose=${onClose} title="더블북 환경 설정" maxWidth="max-w-5xl" zIndex="z-[100]">
      <div className="flex flex-col md:flex-row gap-4 h-[78vh] md:h-[650px] overflow-hidden text-slate-800">
        <div className="flex md:flex-col overflow-x-auto pb-1 md:pb-0 gap-1.5 w-full md:w-48 shrink-0">
          ${[{ id: 'equity', label: '자본금', icon: 'coins' }, { id: 'accounts', label: '계정과목', icon: 'settings' }, { id: 'tags', label: '태그 관리', icon: 'tag' }].map(tab => html`
            <button key=${tab.id} onClick=${() => setSettingsTab(tab.id)} className=${`flex items-center justify-center md:justify-start gap-2 p-3 sm:p-4 rounded-xl font-bold transition-all flex-1 md:flex-none text-xs sm:text-sm whitespace-nowrap ${settingsTab === tab.id ? 'bg-indigo-600 text-white shadow-md' : 'bg-slate-50 text-slate-400 hover:bg-slate-100'}`}>
              <${Icon} name=${tab.icon} className="w-4 h-4" />${tab.label}
            </button>
          `)}
          ${isDirty && html`
            <div className="mt-auto pt-4 hidden md:block">
              <${Button} variant="primary" onClick=${handleSyncSettings} className="w-full bg-orange-500 hover:bg-orange-600 animate-pulse">설정 저장하기<//>
            </div>
          `}
        </div>
        <div className="flex-1 overflow-y-auto pr-0 md:pr-4 modal-scroll pb-10">
          ${settingsTab === 'equity' && html`
            <div className="space-y-6">
              <h4 className="text-sm font-black uppercase tracking-widest text-slate-800 ml-1">자본금 및 기초 부채</h4>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div className="bg-white rounded-2xl border border-slate-200 overflow-hidden flex flex-col shadow-sm">
                  <div className="bg-indigo-600 text-white p-2 text-center text-[10px] font-black uppercase">Debit (차변 - 기초 자산)</div>
                  <div className="p-3 space-y-2 min-h-[150px] flex-1">
                    ${(initialSetup.debits || []).map((r, i) => {
                      const account = r.accountId ? getAccountById(r.accountId) : null;
                      const availableTags = [...(account?.tags || [])];
                      if (r.tag && !availableTags.includes(r.tag)) availableTags.push(r.tag);
                      return html`
                        <div key=${i} className="flex gap-2 items-center">
                          <button onClick=${() => setActiveSetupPicker({ type: 'setupDebits', index: i })} className="flex-1 p-2.5 rounded-lg bg-slate-50 text-[11px] font-bold border border-slate-100 text-left truncate">${account ? account.name : '자산 선택'}</button>
                          <select
                            value=${r.tag || ''}
                            onChange=${(e) => {
                              const val = e.target.value;
                              setData(prev => {
                                const n = [...prev.initialSetup.debits];
                                n[i] = { ...n[i], tag: val };
                                return { ...prev, initialSetup: { ...prev.initialSetup, debits: n } };
                              });
                              setIsDirty(true);
                            }}
                            disabled=${!r.accountId}
                            className="w-24 sm:w-28 p-2 rounded-lg bg-white border border-slate-200 text-xs font-bold outline-none text-slate-700 disabled:opacity-50"
                          >
                            <option value="">태그 없음</option>
                            ${availableTags.map(t => html`<option key=${t} value=${t}>${t}</option>`)}
                          </select>
                          <${MoneyInput}
                            className="w-24 sm:w-28 p-2 rounded-lg bg-white text-right font-black border border-slate-200 text-indigo-600 text-xs sm:text-sm outline-none"
                            value=${r.amount || 0}
                            onChange=${(val) => {
                              setData(prev => {
                                const n = [...prev.initialSetup.debits];
                                n[i] = { ...n[i], amount: val };
                                return { ...prev, initialSetup: { ...prev.initialSetup, debits: n } };
                              });
                              setIsDirty(true);
                            }}
                          />
                          <button onClick=${() => { setData(prev => { const n = [...prev.initialSetup.debits]; if (n.length > 1) n.splice(i, 1); return { ...prev, initialSetup: { ...prev.initialSetup, debits: n } }; }); setIsDirty(true); }} className="text-slate-300 hover:text-red-500 p-1"><${TrashIcon}/></button>
                        </div>
                      `;
                    })}
                    <button onClick=${() => { setData(prev => ({ ...prev, initialSetup: { ...prev.initialSetup, debits: [...(prev.initialSetup.debits || []), { accountId: '', amount: 0, tag: '' }] } })); setIsDirty(true); }} className="w-full p-2 mt-2 text-[10px] font-black text-indigo-500 border border-dashed border-indigo-200 rounded-lg hover:bg-indigo-50">+ 자산 추가</button>
                  </div>
                  <div className="bg-slate-50 p-3 flex justify-between font-black border-t text-xs"><span className="text-[9px] uppercase text-slate-400">Sum of Assets</span><span className="font-mono text-indigo-600 font-black">${setupTotalDebits.toLocaleString()}원</span></div>
                </div>
                <div className="bg-white rounded-2xl border border-slate-200 overflow-hidden flex flex-col h-fit shadow-sm">
                  <div className="bg-emerald-600 text-white p-2 text-center text-[10px] font-black uppercase">Credit (대변 - 자본/부채)</div>
                  <div className="p-3 space-y-3">
                    <div className="p-3 bg-emerald-50 rounded-xl border border-emerald-100 flex justify-between items-center"><span className="font-bold text-emerald-800 text-[11px] sm:text-sm font-black">자본금 (자동 계산)</span><span className="font-mono font-black text-emerald-600 text-xs sm:text-lg">${calculatedInitialCapital.toLocaleString()}원</span></div>
                    <div className="p-3 bg-emerald-50 rounded-xl border border-emerald-100 flex justify-between items-center gap-2">
                      <span className="font-bold text-emerald-800 text-[11px] sm:text-sm font-black">이익잉여금</span>
                      <${MoneyInput}
                        allowNegative=${true}
                        className="w-24 sm:w-32 p-2 rounded-lg bg-white text-right font-black border border-emerald-200 text-emerald-600 text-xs sm:text-sm outline-none font-mono"
                        value=${retainedEarningsAmount || 0}
                        placeholder="0"
                        onChange=${(val) => {
                          setData(prev => {
                            const newCredits = [...(prev.initialSetup.credits || [])];
                            const idx = newCredits.findIndex(c => String(c.accountId) === String(retainedEarningsId));
                            if (idx >= 0) newCredits[idx] = { ...newCredits[idx], amount: val };
                            else newCredits.push({ accountId: retainedEarningsId, amount: val });
                            return { ...prev, initialSetup: { ...prev.initialSetup, credits: newCredits } };
                          });
                          setIsDirty(true);
                        }}
                      />
                    </div>
                    <div className="text-[9px] font-black text-slate-300 uppercase tracking-widest pt-1 border-t mb-1">기초 부채 내역</div>
                    ${(initialSetup.credits || []).filter(r => String(r.accountId) !== String(retainedEarningsId)).map((r) => {
                      const originalIndex = initialSetup.credits.findIndex(c => c === r);
                      const account = r.accountId ? getAccountById(r.accountId) : null;
                      const availableTags = [...(account?.tags || [])];
                      if (r.tag && !availableTags.includes(r.tag)) availableTags.push(r.tag);
                      return html`
                        <div key=${originalIndex} className="flex gap-2 items-center">
                          <button onClick=${() => setActiveSetupPicker({ type: 'setupCredits', index: originalIndex })} className="flex-1 p-2.5 rounded-lg bg-slate-50 text-[11px] font-bold border border-slate-100 text-left truncate">${account ? account.name : '부채 선택'}</button>
                          <select
                            value=${r.tag || ''}
                            onChange=${(e) => {
                              const val = e.target.value;
                              setData(prev => {
                                const n = [...prev.initialSetup.credits];
                                n[originalIndex] = { ...n[originalIndex], tag: val };
                                return { ...prev, initialSetup: { ...prev.initialSetup, credits: n } };
                              });
                              setIsDirty(true);
                            }}
                            disabled=${!r.accountId}
                            className="w-24 sm:w-28 p-2 rounded-lg bg-white border border-slate-200 text-xs font-bold outline-none text-slate-700 disabled:opacity-50"
                          >
                            <option value="">태그 없음</option>
                            ${availableTags.map(t => html`<option key=${t} value=${t}>${t}</option>`)}
                          </select>
                          <${MoneyInput}
                            className="w-24 sm:w-28 p-2 rounded-lg bg-white text-right font-black border border-slate-200 text-red-500 text-xs outline-none"
                            value=${r.amount || 0}
                            onChange=${(val) => {
                              setData(prev => {
                                const n = [...prev.initialSetup.credits];
                                n[originalIndex] = { ...n[originalIndex], amount: val };
                                return { ...prev, initialSetup: { ...prev.initialSetup, credits: n } };
                              });
                              setIsDirty(true);
                            }}
                          />
                          <button onClick=${() => { setData(prev => { const n = [...prev.initialSetup.credits]; n.splice(originalIndex, 1); return { ...prev, initialSetup: { ...prev.initialSetup, credits: n } }; }); setIsDirty(true); }} className="text-slate-300 hover:text-red-500 p-1"><${TrashIcon}/></button>
                        </div>
                      `;
                    })}
                    <button onClick=${() => { setData(prev => ({ ...prev, initialSetup: { ...prev.initialSetup, credits: [...(prev.initialSetup.credits || []), { accountId: '', amount: 0, tag: '' }] } })); setIsDirty(true); }} className="w-full p-2 mt-1 text-[10px] font-black text-red-400 border border-dashed border-red-100 rounded-lg hover:bg-red-50">+ 부채 추가</button>
                  </div>
                </div>
              </div>
            </div>
          `}
          ${settingsTab === 'accounts' && html`
            <div className="space-y-8">
              ${orphanAccountBalances.length > 0 && html`
                <div className="p-4 bg-amber-50 border-2 border-amber-200 rounded-2xl animate-in fade-in">
                  <div className="flex items-center gap-2 font-black text-amber-800 text-xs sm:text-sm mb-1.5">
                    <${Icon} name="alert-triangle" className="w-4 h-4 text-amber-600 shrink-0" />
                    <span>연결 끊긴(미분류) 계정과목이 감지되었습니다 (${orphanAccountBalances.length}개)</span>
                  </div>
                  <p className="text-[11px] text-amber-700 font-medium mb-3">
                    과거에 삭제되었거나 이름/ID 불일치로 등록되지 않은 계정을 참조하는 거래 내역입니다. 차대 균형은 유지되고 있으며, 아래에서 원하는 정상 계정과목으로 일괄 이관(정리)할 수 있습니다.
                  </p>
                  <div className="space-y-2">
                    ${orphanAccountBalances.map(o => html`
                      <div key=${o.id} className="flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-3 bg-white rounded-xl border border-amber-200 shadow-sm">
