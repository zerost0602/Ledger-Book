                        React.createElement('span', { className: `font-mono text-[10px] sm:text-xs font-semibold ${t.amount < 0 ? 'text-rose-500' : 'text-slate-500'}` }, (t.amount < 0 ? `(${Math.abs(t.amount).toLocaleString()})` : Number(t.amount || 0).toLocaleString()) + "원")
                      ))}
                      ${sortedTags.length > 0 && untaggedAmount !== 0 && React.createElement('div', { key: 'untagged', className: "flex justify-between items-center mt-1 pl-3" },
