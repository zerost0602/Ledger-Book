const MonthlyIncomeExpenseReport = ({ accounts, transactions, getAccountById, onEditTransaction }) => {
  const [targetMonth, setTargetMonth] = useState(new Date().toISOString().slice(0, 7));
  const [reportType, setReportType] = useState('expenses'); // 'expenses' | 'revenue'
  const [expandedAccounts, setExpandedAccounts] = useState({});

  const revenueAccountIds = useMemo(() => accounts?.revenue?.map(r => r.id) || [], [accounts]);
  const expenseAccountIds = useMemo(() => accounts?.expenses?.map(e => e.id) || [], [accounts]);

  const targetAccountIds = useMemo(() => {
    return reportType === 'revenue' ? revenueAccountIds : expenseAccountIds;
  }, [reportType, revenueAccountIds, expenseAccountIds]);

  const reportData = useMemo(() => {
    const monthlyTx = transactions.filter(t => {
      const isClosingTx = (t.id && String(t.id).startsWith('CLOSE-')) || (t.memo && t.memo.includes('[결산'));
      return t.date.startsWith(targetMonth) && !isClosingTx;
    });
    
    let map = {};
    let totalVal = 0;

    targetAccountIds.forEach(accId => { map[accId] = { total: 0, lines: [] }; });

    monthlyTx.forEach(tx => {
      (tx.debits || []).forEach(d => {
        if (targetAccountIds.includes(d.accountId)) {
          if (!map[d.accountId]) map[d.accountId] = { total: 0, lines: [] };
          const amt = reportType === 'revenue' ? -d.amount : d.amount;
          map[d.accountId].lines.push({ txId: tx.id, date: tx.date, memo: tx.memo, vendor: tx.vendor || '', amount: amt, tag: d.tag || '' });
          map[d.accountId].total += amt;
          totalVal += amt;
        }
      });
      (tx.credits || []).forEach(c => {
        if (targetAccountIds.includes(c.accountId)) {
          if (!map[c.accountId]) map[c.accountId] = { total: 0, lines: [] };
          const amt = reportType === 'revenue' ? c.amount : -c.amount;
          map[c.accountId].lines.push({ txId: tx.id, date: tx.date, memo: tx.memo, vendor: tx.vendor || '', amount: amt, tag: c.tag || '' });
          map[c.accountId].total += amt;
          totalVal += amt;
        }
      });
    });

    const activeAccountIds = Object.keys(map)
      .filter(accId => map[accId].lines.length > 0)
      .sort((a, b) => {
        const accA = getAccountById(a);
        const accB = getAccountById(b);
        const subA = accA.subtype || 'variable';
        const subB = accB.subtype || 'variable';

        if (subA !== subB) {
          return subA === 'fixed' ? -1 : 1;
        }
        return map[b].total - map[a].total;
      });

    activeAccountIds.forEach(accId => {
      map[accId].lines.sort((a, b) => a.date.localeCompare(b.date));
    });

    // 고정과 변동 그룹 분리 및 소계 산출
    let fixedTotal = 0;
    let variableTotal = 0;
    const fixedAccountIds = [];
    const variableAccountIds = [];

    activeAccountIds.forEach(accId => {
      const acc = getAccountById(accId);
      const sub = acc.subtype || 'variable';
      if (sub === 'fixed') {
        fixedAccountIds.push(accId);
        fixedTotal += map[accId].total;
      } else {
        variableAccountIds.push(accId);
        variableTotal += map[accId].total;
      }
    });

    return { map, activeAccountIds, fixedAccountIds, variableAccountIds, totalVal, fixedTotal, variableTotal };
  }, [transactions, targetMonth, targetAccountIds, reportType, getAccountById]);

  const toggleAccordion = (accountId) => {
    setExpandedAccounts(prev => ({ ...prev, [accountId]: !prev[accountId] }));
  };

  useEffect(() => {
    setTimeout(() => { if (window.lucide) window.lucide.createIcons(); }, 100);
  }, [targetMonth, reportType, expandedAccounts]);

  const renderAccountCard = (accountId) => {
    const isExpanded = !!expandedAccounts[accountId];
    const data = reportData.map[accountId];
    const account = getAccountById(accountId);
    const accountName = account.name;
    const subtype = account.subtype || 'variable';

    return html`
      <div key=${accountId} className="border border-slate-200 rounded-xl overflow-hidden transition-all shadow-sm">
        <div onClick=${() => toggleAccordion(accountId)} className="flex justify-between items-center p-3 sm:p-4 bg-slate-50 hover:bg-slate-100 cursor-pointer transition select-none">
          <div className="font-extrabold text-slate-800 text-sm sm:text-base flex items-center gap-2">
            <span className=${`px-2 py-0.5 rounded-md text-[10px] font-black ${reportType === 'revenue' ? 'bg-emerald-100 text-emerald-600' : 'bg-orange-100 text-orange-600'}`}>
              ${reportType === 'revenue' ? '수익' : '비용'}
            </span>
            <span className=${`px-2 py-0.5 rounded-md text-[10px] font-black ${subtype === 'fixed' ? 'bg-blue-100 text-blue-700' : 'bg-purple-100 text-purple-700'}`}>
              ${subtype === 'fixed' ? '고정' : '변동'}
            </span>
            ${accountName}
          </div>
          <div className="flex items-center gap-4 text-sm">
            <span className="font-mono font-black text-slate-800">${data.total.toLocaleString()}원</span>
            <div className="w-6 flex justify-end text-slate-400">
              ${isExpanded ? html`<i data-lucide="chevron-up" className="w-4 h-4"></i>` : html`<i data-lucide="chevron-down" className="w-4 h-4"></i>`}
            </div>
          </div>
        </div>

        ${isExpanded && (() => {
          const tagMap = {};
          let noTagTotal = 0;
          data.lines.forEach(line => {
            if (line.tag) {
              tagMap[line.tag] = (tagMap[line.tag] || 0) + line.amount;
            } else {
              noTagTotal += line.amount;
            }
          });
          const sortedTags = Object.keys(tagMap)
            .map(tag => ({ tag, amount: tagMap[tag] }))
            .sort((a, b) => b.amount - a.amount);
          return html`
            <div className="border-t border-slate-200 bg-white animate-in slide-in-from-top-2 duration-200">
              <div className="p-3 bg-slate-50/50 border-b flex flex-wrap gap-2 items-center justify-between text-xs font-bold text-slate-600">
                <div className="flex flex-wrap gap-1.5 items-center">
                  <span className="text-[10px] text-slate-400 mr-1 uppercase tracking-wider">소분류 집계:</span>
                  ${sortedTags.map(item => html`
                    <span key=${item.tag} className="bg-indigo-50 border border-indigo-100 text-indigo-600 px-2.5 py-1 rounded-md text-[10px]">
                      #${item.tag} <span className="font-mono text-[10px] text-indigo-500 font-extrabold">${item.amount.toLocaleString()}원</span>
                    </span>
                  `)}
                  ${noTagTotal !== 0 && html`
                    <span className="bg-slate-100 border border-slate-200 text-slate-500 px-2.5 py-1 rounded-md text-[10px]">
                      태그 미지정 <span className="font-mono text-[10px] text-slate-400 font-extrabold">${noTagTotal.toLocaleString()}원</span>
                    </span>
                  `}
                  ${sortedTags.length === 0 && noTagTotal === 0 && html`
                    <span className="text-slate-300 text-[10px] font-bold">집계할 데이터가 없습니다.</span>
                  `}
                </div>
                <div className="text-[10px] sm:text-xs font-black text-slate-700 bg-white border px-3 py-1 rounded-lg shadow-sm">
                  총액: <span className="font-mono text-indigo-600">${data.total.toLocaleString()}원</span>
                </div>
              </div>
              <div className="p-3">
                <table className="w-full text-left table-fixed">
                  <thead className="text-slate-400 text-[9px] sm:text-[10px] font-black uppercase tracking-widest border-b border-slate-100 bg-slate-50">
                    <tr>
                      <th className="py-2 px-1.5 sm:px-3 rounded-tl-lg w-20 sm:w-32 whitespace-nowrap">날짜</th>
                      <th className="py-2 px-1.5 sm:px-3">거래내용</th>
                      <th className="py-2 px-1.5 sm:px-3 text-right rounded-tr-lg w-22 sm:w-28 whitespace-nowrap">금액</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-50">
                    ${data.lines.map((line, idx) => html`
                      <tr key=${idx} onClick=${() => line.txId && onEditTransaction && onEditTransaction(line.txId)} className=${`transition ${line.txId && onEditTransaction ? 'cursor-pointer hover:bg-indigo-50 active:bg-indigo-100' : 'hover:bg-slate-50'}`}>
                        <td className="py-2 px-1.5 sm:py-2.5 sm:px-3 text-slate-500 font-mono text-[10px] sm:text-xs whitespace-nowrap truncate">${line.date}</td>
                        <td className="py-2 px-1.5 sm:py-2.5 sm:px-3 text-slate-700 font-bold text-[10px] sm:text-sm leading-tight" style=${{ wordBreak: 'keep-all', overflowWrap: 'break-word' }}>
                          ${line.vendor && html`<span className="inline-block bg-slate-100 text-slate-600 font-bold text-[9px] sm:text-[10px] px-1.5 py-0.5 rounded mr-1.5 shadow-xs border border-slate-200">${line.vendor}</span>`}
                          ${line.memo || '내역 없음'}
                          ${line.tag && html`<br /><span className="text-[9px] sm:text-xs text-slate-400 font-normal">#${line.tag}</span>`}
                        </td>
                        <td className="py-2 px-1.5 sm:py-2.5 sm:px-3 text-right font-mono font-bold text-slate-800 text-[11px] sm:text-sm whitespace-nowrap">${line.amount.toLocaleString()}원</td>
                      </tr>
                    `)}
                  </tbody>
                </table>
              </div>
            </div>
          `;
        })()}
      </div>
    `;
  };

  return html`
    <div className="max-w-4xl mx-auto space-y-6 animate-in fade-in duration-300 pb-10">
      <div className="bg-white p-4 sm:p-5 rounded-2xl shadow-sm border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <h2 className="text-lg sm:text-xl font-black text-slate-800 flex items-center gap-2">
          <i data-lucide=${reportType === 'revenue' ? 'trending-up' : 'receipt'} className=${reportType === 'revenue' ? 'text-emerald-500' : 'text-orange-500'}></i> 월간손익명세
        </h2>
        <div className="flex items-center gap-3 self-end sm:self-auto">
          <div className="bg-slate-100 p-1 rounded-xl flex gap-1 border border-slate-200">
            <button 
              onClick=${() => { setReportType('revenue'); setExpandedAccounts({}); }} 
              className=${`px-3 py-1.5 rounded-lg text-xs font-black transition-all ${reportType === 'revenue' ? 'bg-white text-emerald-600 shadow-sm' : 'text-slate-500 hover:text-slate-800'}`}
            >
              수익
            </button>
            <button 
              onClick=${() => { setReportType('expenses'); setExpandedAccounts({}); }} 
              className=${`px-3 py-1.5 rounded-lg text-xs font-black transition-all ${reportType === 'expenses' ? 'bg-white text-orange-600 shadow-sm' : 'text-slate-500 hover:text-slate-800'}`}
            >
              비용
            </button>
