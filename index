                      <div className="flex justify-between items-center mb-4"><h5 className="font-black text-indigo-600 uppercase tracking-widest text-[11px]">${type.toUpperCase()} 분류 관리</h5><button onClick=${() => setAddingToCategory(type)} className="text-[10px] bg-indigo-600 text-white px-3 py-1.5 rounded-full font-black shadow-sm">+ 추가</button></div>
                      <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
                        ${['fixed', 'variable'].map(subtype => html`
                          <div key=${subtype} onDragOver=${handleDragOver} onDrop=${() => handleSubtypeDrop(subtype, type)} className="bg-white border-2 border-slate-50 rounded-2xl p-4 sm:p-5 transition-all shadow-sm min-h-[120px]">
                            <div className="flex justify-between items-center mb-3 border-b border-slate-50 pb-1.5 text-slate-400 font-black"><span className="uppercase text-[9px] tracking-widest">${subtype === 'fixed' ? '고정 (Fixed)' : '변동 (Variable)'}</span><i data-lucide=${subtype === 'fixed' ? 'lock' : 'zap'} className="w-3 h-3"></i></div>
                            <div className="grid grid-cols-1 gap-1.5">
                              ${accounts[type].filter(a => (a.subtype || 'fixed') === subtype).map(acc => html`
                                <div key=${acc.id} draggable onDragStart=${() => handleAccountDragStart(acc.id)} className="bg-slate-50 border border-slate-100 px-3 py-2.5 rounded-xl text-xs font-bold flex items-center gap-3 group hover:bg-white hover:border-indigo-100 transition-all text-slate-700 w-full shadow-sm">
                                  <i data-lucide="grip-vertical" className="text-slate-200 shrink-0 hidden sm:block"></i>
                                  <input className="bg-transparent border-none outline-none flex-1 font-bold min-w-0" value=${acc.name} onChange=${(e) => handleUpdateAccountName(type, acc.id, e.target.value)} />
                                  <button onClick=${() => handleDeleteAccount(type, acc.id)} className="sm:opacity-0 group-hover:opacity-100 text-red-400 p-1"><i data-lucide="x" className="w-3.5 h-3.5"></i></button>
                                </div>
                              `)}
                            </div>
                          </div>
                        `)}
                      </div>
                      ${addingToCategory === type && html`<div className="mt-3 p-3 bg-indigo-50 rounded-2xl border border-indigo-100 text-center"><input autoFocus className="bg-transparent border-none outline-none font-black text-indigo-600 text-center text-xs w-full" placeholder="항목 입력 후 Enter..." onBlur=${(e) => handleAddAccount(type, e.target.value)} onKeyDown=${(e)=>e.key==='Enter'&&e.target.blur()} /></div>`}
                    </div>
                  `)}
                </div>
              </div>
            `}
            ${settingsTab === 'tags' && html`
              <div className="space-y-6">
                <div>
                  <h4 className="text-sm font-black uppercase tracking-widest text-slate-800 ml-1">태그 관리</h4>
                  <p className="text-[10px] text-slate-400 ml-1 mt-0.5">각 계정과목별로 거래 세부항목 분류를 위한 태그를 지정하세요.</p>
                </div>
                <div className="grid grid-cols-1 md:grid-cols-3 gap-4 pb-10">
                  <div className="md:col-span-1 bg-slate-50 p-4 rounded-2xl border shadow-inner max-h-[450px] overflow-y-auto modal-scroll text-slate-800 flex flex-col">
                    <div onClick=${() => setIsAccountListOpen(!isAccountListOpen)} className="md:hidden flex justify-between items-center p-1 cursor-pointer select-none border-b pb-2 mb-2">
                      <span className="text-[11px] uppercase text-indigo-500 font-black tracking-widest">
                        ${selectedAccountForTag ? `계정: ${getAccountById(selectedAccountForTag.id)?.name}` : '계정과목 선택'}
                      </span>
                      ${isAccountListOpen ? html`<${ChevronUpIcon} className="w-4 h-4 text-indigo-500" />` : html`<${ChevronDownIcon} className="w-4 h-4 text-indigo-500" />`}
                    </div>
                    <div className="hidden md:block text-[9px] uppercase text-indigo-500 font-black mb-3 tracking-widest">계정과목 선택</div>
                    
                    <div className=${`space-y-4 ` + (isAccountListOpen ? 'block' : 'hidden md:block')}>
                      ${['assets', 'liabilities', 'revenue', 'expenses'].map(cat => html`
                        <div key=${cat} className="space-y-1">
                          <div className="text-[8px] font-black text-slate-400 uppercase tracking-wider">${cat === 'assets' ? '자산 (Assets)' : cat === 'liabilities' ? '부채/자본 (Liabilities)' : cat === 'revenue' ? '수익 (Revenue)' : '비용 (Expenses)'}</div>
                          ${(accounts[cat] || []).filter(a => a.name !== '이익잉여금').map(a => html`
                            <button
                              key=${a.id}
                              onClick=${() => {
                                setSelectedAccountForTag({ category: cat, id: a.id });
                                setIsAccountListOpen(false);
                              }}
                              className=${"w-full text-left p-2.5 rounded-xl text-xs font-bold transition-all " + (selectedAccountForTag && selectedAccountForTag.id === a.id ? "bg-indigo-600 text-white shadow-sm" : "bg-white hover:bg-slate-100 text-slate-700 border border-slate-100 shadow-sm")}
                            >
                              ${a.name}
                            </button>
                          `)}
                        </div>
                      `)}
                    </div>
                  </div>
                  
                  <div className=${`md:col-span-2 bg-white p-4 rounded-2xl border shadow-sm min-h-[300px] flex flex-col justify-between text-slate-800 ` + (!isAccountListOpen || selectedAccountForTag ? 'block' : 'hidden md:block')}>
                    ${selectedAccountForTag ? html`
                      <div className="flex-1 flex flex-col">
                        <div className="flex justify-between items-center border-b pb-3 mb-4">
                          <h5 className="font-black text-indigo-600 text-xs sm:text-sm">
                            [${getAccountById(selectedAccountForTag.id)?.name}] 태그 목록
                          </h5>
                          <span className="text-[9px] text-slate-400 font-bold uppercase tracking-widest">
                            태그: ${(getAccountById(selectedAccountForTag.id)?.tags || []).length}개
                          </span>
                        </div>
                        
                        <div className="flex flex-wrap gap-2 mb-6 flex-1 content-start">
                          ${(getAccountById(selectedAccountForTag.id)?.tags || []).length === 0 ? html`
                            <div className="flex flex-col items-center justify-center py-10 w-full text-slate-300 gap-1.5">
                              <${TagIcon} className="w-5 h-5 text-slate-300" />
                              <p className="text-[10px] font-bold">등록된 태그가 없습니다. 아래에서 새 태그를 추가하세요.</p>
                            </div>
                          ` : (getAccountById(selectedAccountForTag.id)?.tags || []).map(tag => html`
                            <span key=${tag} className="inline-flex items-center gap-1.5 bg-indigo-50 border border-indigo-100 text-indigo-600 px-3 py-1.5 rounded-full text-xs font-black shadow-sm">
                              #${tag}
                              <button onClick=${() => handleRemoveTag(selectedAccountForTag.category, selectedAccountForTag.id, tag)} className="text-indigo-400 hover:text-red-500 transition-colors p-0.5">
                                <${XIcon} className="w-3 h-3 text-indigo-400 hover:text-red-500" />
                              </button>
                            </span>
                          `)}
                        </div>
                      </div>
                      
                      <div className="border-t pt-4">
                        <div className="flex gap-2">
                          <input
                            id="new-tag-input"
                            type="text"
                            placeholder="새 태그 이름 입력 후 Enter (예: 외식, 배달)"
                            className="flex-1 p-2.5 rounded-xl border border-slate-200 text-xs font-bold text-slate-700 bg-white outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                            onKeyDown=${(e) => {
                              if (e.key === 'Enter') {
                                handleAddTag(selectedAccountForTag.category, selectedAccountForTag.id, e.target.value);
                                e.target.value = '';
                              }
                            }}
                          />
                          <button
                            onClick=${() => {
                              const input = document.getElementById('new-tag-input');
                              if (input && input.value.trim()) {
                                handleAddTag(selectedAccountForTag.category, selectedAccountForTag.id, input.value);
                                input.value = '';
                              }
                            }}
                            className="bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs px-4 py-2.5 rounded-xl transition-all shadow-sm active:scale-95"
                          >
                            추가
                          </button>
                        </div>
                      </div>
                    ` : html`
                      <div className="flex flex-col items-center justify-center h-full text-slate-300 gap-2 py-20 flex-1">
                        <${TagIcon} className="w-8 h-8 text-slate-300" />
                        <p className="text-xs font-bold">왼쪽 목록에서 계정과목을 선택하여 태그를 관리하세요.</p>
                      </div>
                    `}
                  </div>
                </div>
              </div>
            `}
            ${isDirty && html`
              <div className="mt-6 md:hidden">
                <${Button} variant="primary" onClick=${handleSyncSettings} className="w-full bg-orange-500 hover:bg-orange-600 animate-pulse">설정 변경사항 저장하기<//>
              </div>
            `}
          </div>
        </div>
      <//>

      <${Modal} isOpen=${isEntryModalOpen} onClose=${() => {setIsEntryModalOpen(false); setEditingTransaction(null);}} title=${editingTransaction?"전표 수정":"전표 입력"} maxWidth="max-w-6xl" zIndex="z-[120]">
        <div className="flex flex-col lg:flex-row gap-4 sm:gap-6 text-slate-800">
          <div className="w-full lg:w-48 shrink-0 bg-slate-50 p-4 rounded-2xl border h-fit shadow-inner">
            <label className="block text-[9px] font-black text-slate-400 uppercase mb-2 text-center lg:text-left">전표 날짜</label>
            <input type="date" className="w-full p-2.5 rounded-xl border text-xs font-bold outline-none mb-3 shadow-sm bg-white text-slate-700" value=${entryRows.date} onChange=${(e) => setEntryRows({...entryRows, date: e.target.value})} />
            ${editingTransaction && html`<button onClick=${handleDeleteTransactionWrapper} className="w-full p-3 bg-red-50 text-red-500 rounded-xl font-bold text-[11px] hover:bg-red-500 hover:text-white transition-all shadow-sm flex items-center justify-center gap-2"><i data-lucide="trash-2" className="w-3.5 h-3.5"></i>삭제하기</button>`}
          </div>
          <div className="flex-1 space-y-4 pb-20 sm:pb-0">
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div className="bg-white rounded-2xl border shadow-sm flex flex-col overflow-hidden">
                <div className="bg-indigo-600 text-white p-2 font-black text-center text-[10px] uppercase">Debit (차변)</div>
                <div className="p-3 space-y-2 min-h-[120px] sm:min-h-[250px] flex-1">
                  ${entryRows.debits.map((r, i) => {
                    const account = r.accountId ? getAccountById(r.accountId) : null;
                    const availableTags = [...(account?.tags || [])];
                    if (r.tag && !availableTags.includes(r.tag)) {
                      availableTags.push(r.tag);
                    }
                    return html`
                      <div key=${i} className="flex gap-1.5 items-center animate-in slide-in-from-left-2">
                        <button onClick=${() => setActivePicker({ type: 'debits', index: i })} className="flex-1 min-w-[70px] p-2.5 rounded-lg bg-slate-50 text-[11px] font-bold border border-slate-100 text-left truncate active:bg-indigo-50">${account ? account.name : '계정 선택'}</button>
                        <select 
                          value=${r.tag || ''} 
                          onChange=${(e) => handleUpdateEntryRow('debits', i, 'tag', e.target.value)}
                          disabled=${!r.accountId}
                          className="w-24 sm:w-28 p-2 rounded-lg bg-white border border-slate-200 text-xs font-bold outline-none text-slate-700 disabled:opacity-50"
                        >
                          <option value="">태그 없음</option>
                          ${availableTags.map(t => html`
                            <option key=${t} value=${t}>${t}</option>
                          `)}
                        </select>
                        <input type="number" className="w-20 sm:w-24 p-2 rounded-lg bg-white text-right font-black border border-slate-200 text-xs outline-none" placeholder="0" value=${r.amount || ''} onChange=${(e) => handleUpdateEntryRow('debits', i, 'amount', Number(e.target.value))} />
                        <button onClick=${()=>{const n=[...entryRows.debits]; if(n.length>1){n.splice(i,1); setEntryRows(prev => ({...prev, debits:n}));}}} className="text-slate-300 hover:text-red-500 p-1"><${TrashIcon}/></button>
                      </div>
                    `;
                  })}
                  <button onClick=${() => setEntryRows(prev => ({...prev, debits: [...prev.debits, {accountId:'', amount:0, tag:''}]}))} className="w-full p-2 mt-1 text-[10px] font-black text-indigo-500 border border-dashed border-indigo-200 rounded-lg hover:bg-indigo-50">+ 행 추가</button>
                </div>
                <div className="bg-slate-50 p-2.5 flex justify-between items-center font-black border-t text-xs sm:text-base">
                  <span className="text-[9px] uppercase text-slate-400">Total Debit</span>
                  ${totalCreditSum > totalDebitSum && html`
                    <span className="text-[10px] sm:text-xs text-red-500 font-black px-2 py-0.5 rounded-md bg-red-50 border border-red-100 animate-pulse">
                      ${(totalCreditSum - totalDebitSum).toLocaleString()}원 부족
                    </span>
                  `}
                  <span className="font-mono text-indigo-600 font-black">${totalDebitSum.toLocaleString()}원</span>
                </div>
              </div>
              <div className="bg-white rounded-2xl border shadow-sm flex flex-col overflow-hidden">
                <div className="bg-red-500 text-white p-2 font-black text-center text-[10px] uppercase">Credit (대변)</div>
                <div className="p-3 space-y-2 min-h-[120px] sm:min-h-[250px] flex-1">
                  ${entryRows.credits.map((r, i) => {
                    const account = r.accountId ? getAccountById(r.accountId) : null;
                    const availableTags = [...(account?.tags || [])];
                    if (r.tag && !availableTags.includes(r.tag)) {
                      availableTags.push(r.tag);
                    }
                    return html`
                      <div key=${i} className="flex gap-1.5 items-center animate-in slide-in-from-right-2">
                        <button onClick=${() => setActivePicker({ type: 'credits', index: i })} className="flex-1 min-w-[70px] p-2.5 rounded-lg bg-slate-50 text-[11px] font-bold border border-slate-100 text-left truncate active:bg-red-50">${account ? account.name : '계정 선택'}</button>
                        <select 
                          value=${r.tag || ''} 
                          onChange=${(e) => handleUpdateEntryRow('credits', i, 'tag', e.target.value)}
                          disabled=${!r.accountId}
                          className="w-24 sm:w-28 p-2 rounded-lg bg-white border border-slate-200 text-xs font-bold outline-none text-slate-700 disabled:opacity-50"
                        >
                          <option value="">태그 없음</option>
                          ${availableTags.map(t => html`
                            <option key=${t} value=${t}>${t}</option>
                          `)}
                        </select>
                        <input type="number" className="w-20 sm:w-24 p-2 rounded-lg bg-white text-right font-black border border-slate-200 text-xs outline-none" placeholder="0" value=${r.amount || ''} onChange=${(e) => handleUpdateEntryRow('credits', i, 'amount', Number(e.target.value))} />
                        <button onClick=${()=>{const n=[...entryRows.credits]; if(n.length>1){n.splice(i,1); setEntryRows(prev => ({...prev, credits:n}));}}} className="text-slate-300 hover:text-red-500 p-1"><${TrashIcon}/></button>
                      </div>
                    `;
                  })}
                  <button onClick=${() => setEntryRows(prev => ({...prev, credits: [...prev.credits, {accountId:'', amount:0, tag:''}]}))} className="w-full p-2 mt-1 text-[10px] font-black text-red-500 border border-dashed border-red-200 rounded-lg hover:bg-red-50">+ 행 추가</button>
                </div>
                <div className="bg-slate-50 p-2.5 flex justify-between items-center font-black border-t text-xs sm:text-base">
                  <span className="text-[9px] uppercase text-slate-400">Total Credit</span>
                  ${totalDebitSum > totalCreditSum && html`
                    <span className="text-[10px] sm:text-xs text-red-500 font-black px-2 py-0.5 rounded-md bg-red-50 border border-red-100 animate-pulse">
                      ${(totalDebitSum - totalCreditSum).toLocaleString()}원 부족
                    </span>
                  `}
                  <span className="font-mono text-red-500 font-black">${totalCreditSum.toLocaleString()}원</span>
                </div>
              </div>
            </div>
            <div className="bg-slate-50 p-3 sm:p-4 rounded-2xl border flex flex-col gap-3 shadow-inner">
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label className="block text-[9px] font-black text-slate-400 uppercase mb-1 ml-1">거래처 (Counterparty)</label>
                  <input type="text" className="w-full bg-white p-2.5 rounded-xl border border-slate-200 outline-none font-bold placeholder:text-slate-300 text-slate-700 text-xs sm:text-sm" placeholder="거래처 입력 (예: 스타벅스, 쿠팡)" value=${entryRows.vendor || ''} onChange=${(e) => setEntryRows({...entryRows, vendor: e.target.value})} />
                </div>
                <div>
                  <label className="block text-[9px] font-black text-slate-400 uppercase mb-1 ml-1">거래 내용 (Memo)</label>
                  <input type="text" className="w-full bg-white p-2.5 rounded-xl border border-slate-200 outline-none font-bold placeholder:text-slate-300 text-slate-700 text-xs sm:text-sm" placeholder="거래 메모를 입력하세요 (예: 식비 결제)" value=${entryRows.memo || ''} onChange=${(e) => setEntryRows({...entryRows, memo: e.target.value})} />
                </div>
              </div>
              <div className="flex items-center justify-between gap-4">
                <span className=${`px-4 py-2 rounded-full text-[10px] font-black uppercase shadow-sm ${totalDebitSum === totalCreditSum && totalDebitSum > 0 ? 'bg-emerald-500 text-white' : 'bg-slate-200 text-slate-500'}`}>
                  ${totalDebitSum === totalCreditSum && totalDebitSum > 0 
                    ? '차대일치' 
                    : `불일치 (${Math.abs(totalDebitSum - totalCreditSum).toLocaleString()}원 부족)`}
                </span>
                <button onClick=${handleSaveEntry} disabled=${isSavingEntry || totalDebitSum !== totalCreditSum || totalDebitSum === 0} className="flex-1 bg-indigo-600 hover:bg-indigo-700 disabled:bg-slate-300 text-white px-6 py-3 rounded-xl font-black shadow-lg transition-all active:scale-95 text-xs sm:text-sm whitespace-nowrap">
                  ${isSavingEntry ? html`
                    <span className="flex items-center justify-center gap-2">
                      <i data-lucide="loader-2" className="w-4 h-4 animate-spin"></i> 저장 중...
                    </span>
                  ` : "전표 저장하기"}
                </button>
              </div>
            </div>
          </div>
        </div>
      <//>

      <${Modal} isOpen=${activePicker !== null} onClose=${() => setActivePicker(null)} title="계정과목 선택" maxWidth="max-w-4xl" zIndex="z-[150]">
        <${AccountGridPicker} accounts=${accounts} onPick=${handleAccountPick} />
      <//>

      <${PrintReportModal} 
        isOpen=${isPrintReportModalOpen} 
        onClose=${() => setIsPrintReportModalOpen(false)} 
        transactions=${transactions} 
        accounts=${accounts} 
        getAccountById=${getAccountById} 
        dateRange=${searchDateRange} 
        searchTerm=${searchTerm} 
      />
    </div>
  `;
};

const Root = () => html`
  <${ErrorBoundary}>
    <${App} />
  <//>
`;

const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(html`<${Root} />`);
</script>
</body>
</html>
