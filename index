                      </tr>
                    </thead>
                    <tbody className="divide-y divide-slate-100 font-medium">
                      ${repaymentSchedule.schedule.length === 0 ? html`
                        <tr><td colSpan="6" className="py-8 text-center text-slate-400">상환할 잔액이 없습니다 (0원).</td></tr>
                      ` : repaymentSchedule.schedule.map((item, idx) => {
                        const isLast = idx === repaymentSchedule.schedule.length - 1;
                        return html`
                          <tr key=${item.round} className=${`hover:bg-slate-50/60 ${isLast ? 'bg-indigo-50/50 font-bold' : ''}`}>
                            <td className="py-2 px-4 text-center font-mono text-slate-400">${item.round}</td>
