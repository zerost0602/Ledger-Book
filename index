const MonthlyIncomeExpenseReport = ({ accounts, transactions, getAccountById, onEditTransaction }) => {
  const [targetMonth, setTargetMonth] = useState(() => formatLocalYearMonth());
  const [reportType, setReportType] = useState('expenses'); // 'expenses' | 'revenue'
  const [expandedAccounts, setExpandedAccounts] = useState({});

  const revenueAccountIds = useMemo(() => accounts?.revenue?.map(r => r.id) || [], [accounts]);
  const expenseAccountIds = useMemo(() => accounts?.expenses?.map(e => e.id) || [], [accounts]);

  const targetAccountIds = useMemo(() => {
    return reportType === 'revenue' ? revenueAccountIds : expenseAccountIds;
  }, [reportType, revenueAccountIds, expenseAccountIds]);

  const reportData = useMemo(() => {
    const monthlyTx = transactions.filter(t => t.date.startsWith(targetMonth) && !isClosingTransaction(t));
    
    let map = {};
    let totalVal = 0;

    targetAccountIds.forEach(accId => { map[accId] = { total: 0, lines: [] }; });

    monthlyTx.forEach(tx => {
      (tx.debits || []).forEach(d => {
        if (targetAccountIds.includes(d.accountId)) {
          if (!map[d.accountId]) map[d.accountId] = { total: 0, lines: [] };
          const amt = reportType === 'revenue' ? -d.amount : d.amount;
          map[d.accountId].lines.push({ txId: tx.id, date: tx.date, memo: tx.memo, vendor: tx.vendor || '', amount: amt, tag: d.tag || '' });
          map[d.accountId].total += amt;
          totalVal += amt;
        }
      });
      (tx.credits || []).forEach(c => {
        if (targetAccountIds.includes(c.accountId)) {
          if (!map[c.accountId]) map[c.accountId] = { total: 0, lines: [] };
          const amt = reportType === 'revenue' ? c.amount : -c.amount;
          map[c.accountId].lines.push({ txId: tx.id, date: tx.date, memo: tx.memo, vendor: tx.vendor || '', amount: amt, tag: c.tag || '' });
          map[c.accountId].total += amt;
          totalVal += amt;
        }
      });
    });

    const activeAccountIds = Object.keys(map)
      .filter(accId => map[accId].lines.length > 0)
      .sort((a, b) => {
        const accA = getAccountById(a);
        const accB = getAccountById(b);
        const subA = accA.subtype || 'fixed';
        const subB = accB.subtype || 'fixed';

        if (subA !== subB) {
          return subA === 'fixed' ? -1 : 1;
        }
        return map[b].total - map[a].total;
      });

    activeAccountIds.forEach(accId => {
      map[accId].lines.sort((a, b) => a.date.localeCompare(b.date));
    });

    // 고정과 변동 그룹 분리 및 소계 산출
    let fixedTotal = 0;
    let variableTotal = 0;
    const fixedAccountIds = [];
    const variableAccountIds = [];

    activeAccountIds.forEach(accId => {
      const acc = getAccountById(accId);
      const sub = acc.subtype || 'fixed';
      if (sub === 'fixed') {
        fixedAccountIds.push(accId);
        fixedTotal += map[accId].total;
      } else {
        variableAccountIds.push(accId);
        variableTotal += map[accId].total;
      }
    });

    return { map, activeAccountIds, fixedAccountIds, variableAccountIds, totalVal, fixedTotal, variableTotal };
  }, [transactions, targetMonth, targetAccountIds, reportType, getAccountById]);

  const toggleAccordion = (accountId) => {
    setExpandedAccounts(prev => ({ ...prev, [accountId]: !prev[accountId] }));
  };

  const renderAccountCard = (accountId) => {
    const isExpanded = !!expandedAccounts[accountId];
    const data = reportData.map[accountId];
    const account = getAccountById(accountId);
    const accountName = account.name;
    const subtype = account.subtype || 'fixed';

    return html`
      <div key=${accountId} className="border border-slate-200 rounded-xl overflow-hidden transition-all shadow-sm">
        <div onClick=${() => toggleAccordion(accountId)} className="flex justify-between items-center p-3 sm:p-4 bg-slate-50 hover:bg-slate-100 cursor-pointer transition select-none">
          <div className="font-extrabold text-slate-800 text-sm sm:text-base flex items-center gap-2">
            <span className=${`px-2 py-0.5 rounded-md text-[10px] font-black ${reportType === 'revenue' ? 'bg-emerald-100 text-emerald-600' : 'bg-orange-100 text-orange-600'}`}>
              ${reportType === 'revenue' ? '수익' : '비용'}
            </span>
            <span className=${`px-2 py-0.5 rounded-md text-[10px] font-black ${subtype === 'fixed' ? 'bg-blue-100 text-blue-700' : 'bg-purple-100 text-purple-700'}`}>
              ${subtype === 'fixed' ? '고정' : '변동'}
            </span>
            ${accountName}
          </div>
          <div className="flex items-center gap-4 text-sm">
            <span className="font-mono font-black text-slate-800">${data.total.toLocaleString()}원</span>
            <div className="w-6 flex justify-end text-slate-400">
              <${Icon} name=${isExpanded ? 'chevron-up' : 'chevron-down'} className="w-4 h-4" />
            </div>
          </div>
        </div>

        ${isExpanded && (() => {
          const tagMap = {};
          let noTagTotal = 0;
          data.lines.forEach(line => {
            if (line.tag) {
              tagMap[line.tag] = (tagMap[line.tag] || 0) + line.amount;
            } else {
              noTagTotal += line.amount;
            }
          });
          const sortedTags = Object.keys(tagMap)
            .map(tag => ({ tag, amount: tagMap[tag] }))
            .sort((a, b) => b.amount - a.amount);
          return html`
            <div className="border-t border-slate-200 bg-white animate-in slide-in-from-top-2 duration-200">
