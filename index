  const hasSize = /\bw-\d|\bh-\d/.test(className);
  const finalClass = `${hasSize ? '' : 'w-5 h-5 '}${className}`.trim();
  return html`
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className=${finalClass}>
      ${renderPaths(html)}
    </svg>
  `;
};

